@model Biblioteka.ViewComponents.OverdueNotificationViewModel

@if (Model.OverdueCount > 0)
{
    <div class="alert alert-danger d-flex flex-wrap justify-content-between align-items-center shadow-sm mb-3 d-print-none" role="alert">
        <div>
            <i class="bi bi-exclamation-octagon-fill me-2"></i>
            <strong>Masz przetrzymane książki (@Model.OverdueCount szt.)!</strong>
            Naliczona kara wynosi obecnie <strong>@Model.TotalFine.ToString("0.00") zł</strong>.
            <span class="d-block d-md-inline small text-danger-emphasis ms-md-2">
                (@string.Join(", ", Model.OverdueTitles))
            </span>
        </div>
        <a asp-controller="Borrowings" asp-action="MyBorrowings" class="btn btn-sm btn-danger mt-2 mt-md-0">
            <i class="bi bi-journal-check me-1"></i>Sprawdź moje wypożyczenia
        </a>
    </div>
}

@if (Model.DueSoonCount > 0)
{
    <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center shadow-sm mb-3 d-print-none" role="alert">
        <div>
            <i class="bi bi-clock-history me-2"></i>
            <strong>Zbliża się termin zwrotu (@Model.DueSoonCount szt.):</strong>
            <span class="ms-1">@string.Join(", ", Model.DueSoonTitles)</span>
        </div>
        <a asp-controller="Borrowings" asp-action="MyBorrowings" class="btn btn-sm btn-outline-dark mt-2 mt-md-0">
            Szczegóły
        </a>
    </div>
}

@if (Model.IsStaff && Model.GlobalOverdueCount > 0)
{
    <div class="alert alert-secondary border-start border-danger border-4 d-flex flex-wrap justify-content-between align-items-center py-2 mb-3 d-print-none" role="alert">
        <div class="small">
            <i class="bi bi-shield-exclamation text-danger me-2"></i>
            <strong>Panel bibliotekarza:</strong> W systemie znajduje się obecnie
            <span class="badge bg-danger">@Model.GlobalOverdueCount</span> przetrzymanych egzemplarzy po terminie zwrotu.
        </div>
        <a asp-controller="Borrowings" asp-action="OverdueReport" class="btn btn-sm btn-outline-danger">
            Otwórz raport zaległości
        </a>
    </div>
}