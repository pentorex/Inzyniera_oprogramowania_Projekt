@model ErrorViewModel
@{
    ViewData["Title"] = "Wystąpił błąd";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6">
            <div class="card border-0">
                <div class="card-body p-4 p-sm-5 text-center">
                    <!-- Ikona błędu w odcieniu Koral -->
                    <div class="rounded-3 d-inline-flex align-items-center justify-content-center mb-3"
                         style="width: 56px; height: 56px; font-size: 1.5rem; background-color: rgba(232, 93, 74, 0.12); color: #E85D4A;">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>

                    <h2 class="h4 fw-bold mb-2">Coś poszło nie tak</h2>
                    <p class="text-muted small mb-4">
                        Podczas przetwarzania Twojego żądania wystąpił nieoczekiwany błąd. Spróbuj odświeżyć stronę lub wróć do katalogu biblioteki.
                    </p>

                    @if (Model?.ShowRequestId ?? false)
                    {
                        <div class="bg-light rounded-3 px-3 py-2 mb-4 d-inline-block border">
                            <span class="text-muted small me-1">Identyfikator żądania (Request ID):</span>
                            <code class="fw-semibold text-dark">@Model!.RequestId</code>
                        </div>
                    }

                    <!-- Przyciski nawigacji -->
                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-accent px-4 py-2 fw-semibold">
                            <i class="bi bi-house me-1"></i>Strona główna
                        </a>
                        <a asp-area="" asp-controller="Books" asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
                            <i class="bi bi-book me-1"></i>Przeglądaj katalog
                        </a>
                    </div>

                    <!-- Informacja diagnostyczna -->
                    <div class="mt-4 pt-3 border-top">
                        <p class="text-muted mb-0" style="font-size: 0.78rem;">
                            <i class="bi bi-info-circle me-1"></i>
                            Szczegółowe informacje o wyjątkach są wyświetlane wyłącznie w środowisku <strong>Development</strong>.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>