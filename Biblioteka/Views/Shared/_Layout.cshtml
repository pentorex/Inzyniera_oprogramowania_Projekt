@using Biblioteka.Constants
@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
    bool isAdmin = User.Identity?.IsAuthenticated == true && User.IsInRole(UserRoles.Admin);
    bool isStaff = isAdmin || (User.Identity?.IsAuthenticated == true && User.IsInRole(UserRoles.Librarian));
}
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Biblioteka</title>

    <!-- Czcionka Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Biblioteka.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top d-print-none">
        <nav class="navbar navbar-expand-lg navbar-dark navbar-nordic">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon-badge">
                        <i class="bi bi-book-half"></i>
                    </span>
                    <span>Biblioteka</span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Przełącz nawigację">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")"
                               asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>Start
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Books" ? "active" : "")"
                               asp-area="" asp-controller="Books" asp-action="Index">
                                <i class="bi bi-collection me-1"></i>Katalog książek
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Borrowings" && currentAction == "MyBorrowings" ? "active" : "")"
                                   asp-area="" asp-controller="Borrowings" asp-action="MyBorrowings">
                                    <i class="bi bi-bookmark-heart me-1"></i>Moje wypożyczenia
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Reservations" && currentAction == "MyReservations" ? "active" : "")"
                                   asp-area="" asp-controller="Reservations" asp-action="MyReservations">
                                    <i class="bi bi-calendar-check me-1"></i>Moje rezerwacje
                                </a>
                            </li>
                        }

                        @if (isStaff)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(new[] { "Borrowings", "Authors", "Categories", "AdminUsers" }.Contains(currentController) && currentAction != "MyBorrowings" ? "active" : "")"
                                   href="#" id="staffDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @if (isAdmin)
                                    {
                                        <i class="bi bi-shield-lock me-1"></i>
                                
                                        <span>Panel admina</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-sliders2 me-1"></i>
                                
                                        <span>Panel bibliotekarza</span>
                                    }
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="staffDropdown">
                                    <li><h6 class="dropdown-header text-uppercase small fw-bold text-muted">Obieg książek</h6></li>
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Borrowings" asp-action="Create">
                                            <i class="bi bi-plus-circle text-accent me-2"></i>Nowe wypożyczenie
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Borrowings" asp-action="Index">
                                            <i class="bi bi-arrow-left-right text-primary me-2"></i>Wszystkie wypożyczenia
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item text-danger fw-semibold" asp-area="" asp-controller="Borrowings" asp-action="OverdueReport">
                                            <i class="bi bi-exclamation-triangle-fill me-2"></i>Raport zaległości i kar
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header text-uppercase small fw-bold text-muted">Zasoby katalogu</h6></li>
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Books" asp-action="Create">
                                            <i class="bi bi-journal-plus text-primary me-2"></i>Dodaj książkę
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Authors" asp-action="Index">
                                            <i class="bi bi-person-lines-fill text-primary me-2"></i>Autorzy
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Categories" asp-action="Index">
                                            <i class="bi bi-tags text-primary me-2"></i>Kategorie
                                        </a>
                                    </li>

                                    @if (isAdmin)
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header text-uppercase small fw-bold text-muted">Administracja</h6></li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="AdminUsers" asp-action="Index">
                                                <i class="bi bi-people-fill text-primary me-2"></i>Zarządzanie użytkownikami
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 pb-5">
        <div class="container pt-3">
            @await Component.InvokeAsync("OverdueNotification")

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-print-none" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zamknij"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 d-print-none" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zamknij"></button>
                </div>
            }
        </div>

        @RenderBody()
    </main>

    <footer class="footer-nordic py-4 d-print-none">
        <div class="container">
            <div class="row g-4 align-items-center">
                <div class="col-md-5">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-primary-soft px-2 py-1">
                            <i class="bi bi-book-half"></i>
                        </span>
                        <span class="fw-bold text-dark">System Biblioteczny</span>
                    </div>
                    <p class="small mb-0">
                        Nowoczesny katalog online, szybkie rezerwacje egzemplarzy oraz pełna historia wypożyczeń w jednym miejscu.
                    </p>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold text-dark small text-uppercase mb-2">Szybka nawigacja</h6>
                    <ul class="list-unstyled small mb-0 d-flex flex-wrap gap-3">
                        <li><a asp-controller="Books" asp-action="Index">Katalog książek</a></li>
                        <li><a asp-controller="Borrowings" asp-action="MyBorrowings">Moje wypożyczenia</a></li>
                        <li><a asp-controller="Reservations" asp-action="MyReservations">Moje rezerwacje</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Polityka prywatności</a></li>
                    </ul>
                </div>
                <div class="col-md-3 text-md-end small">
                    <div class="text-dark fw-semibold">Godziny otwarcia</div>
                    <div>Pon – Pt: 08:00 – 19:00</div>
                    <div class="text-muted mt-1">&copy; @DateTime.Now.Year Biblioteka</div>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>