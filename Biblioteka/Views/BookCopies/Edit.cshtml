@model Biblioteka.Models.BookCopy

@{
    ViewData["Title"] = "Edycja Egzemplarza";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="card-title mb-0"><i class="bi bi-pencil-square me-2"></i>Edycja Egzemplarza: @Model.InventoryNumber</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="BookId" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="InventoryNumber" class="form-label fw-bold"></label>
                        <input asp-for="InventoryNumber" class="form-control" />
                        <span asp-validation-for="InventoryNumber" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-bold"></label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<Biblioteka.Models.BookStatus>()" class="form-select"></select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Condition" class="form-label fw-bold"></label>
                            <select asp-for="Condition" asp-items="Html.GetEnumSelectList<Biblioteka.Models.BookCondition>()" class="form-select"></select>
                            <span asp-validation-for="Condition" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AcquisitionDate" class="form-label fw-bold"></label>
                        <input asp-for="AcquisitionDate" class="form-control" type="date" />
                        <span asp-validation-for="AcquisitionDate" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Comments" class="form-label fw-bold"></label>
                        <textarea asp-for="Comments" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Comments" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-controller="Books" asp-action="Details" asp-route-id="@Model.BookId" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Anuluj
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-1"></i>Zapisz zmiany
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}