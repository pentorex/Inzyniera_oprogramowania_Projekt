@model Biblioteka.Models.BookCopy

@{
    ViewData["Title"] = "Dodaj Nowy Egzemplarz";
    var bookTitle = ViewData["BookTitle"]?.ToString();
}

<div class="container py-4">
    <!-- Nawigacja okruszkowa -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item">
                <a asp-controller="Books" asp-action="Index" class="text-decoration-none">Katalog książek</a>
            </li>
            @if (!string.IsNullOrWhiteSpace(bookTitle))
            {
                <li class="breadcrumb-item">
                    <a asp-controller="Books" asp-action="Details" asp-route-id="@Model.BookId"
                       class="text-decoration-none text-truncate d-inline-block align-bottom" style="max-width: 240px;">
                        @bookTitle
                    </a>
                </li>
            }
            <li class="breadcrumb-item active" aria-current="page">Nowy egzemplarz</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-12 col-md-9 col-lg-7">
            <div class="card border-0">
                <div class="card-body p-3 p-sm-4 p-md-5">
                    <!-- Nagłówek formularza -->
                    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                        <div class="bg-primary-soft rounded-3 p-3 fs-4 flex-shrink-0">
                            <i class="bi bi-journal-plus"></i>
                        </div>
                        <div class="overflow-hidden">
                            <h2 class="h4 fw-bold mb-1">Nowy egzemplarz</h2>
                            @if (!string.IsNullOrWhiteSpace(bookTitle))
                            {
                                <p class="text-muted mb-0 small text-truncate">
                                    Książka: <strong class="text-dark">@bookTitle</strong>
                                </p>
                            }
                            else
                            {
                                <p class="text-muted mb-0 small">Zarejestruj nowy fizyczny egzemplarz w zasobach biblioteki</p>
                            }
                        </div>
                    </div>

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="BookId" />

                        <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                        <!-- Numer inwentarzowy -->
                        <div class="mb-3">
                            <label asp-for="InventoryNumber" class="form-label fw-semibold small text-muted mb-1"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white text-muted border-end-0">
                                    <i class="bi bi-upc-scan"></i>
                                </span>
                                <input asp-for="InventoryNumber" class="form-control border-start-0 ps-0" placeholder="np. INV-2026-001" />
                            </div>
                            <span asp-validation-for="InventoryNumber" class="text-danger small"></span>
                        </div>

                        <!-- Status i Stan fizyczny -->
                        <div class="row g-3 mb-3">
                            <div class="col-12 col-sm-6">
                                <label asp-for="Status" class="form-label fw-semibold small text-muted mb-1"></label>
                                <select asp-for="Status" asp-items="Html.GetEnumSelectList<Biblioteka.Models.BookStatus>()" class="form-select"></select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label asp-for="Condition" class="form-label fw-semibold small text-muted mb-1"></label>
                                <select asp-for="Condition" asp-items="Html.GetEnumSelectList<Biblioteka.Models.BookCondition>()" class="form-select"></select>
                                <span asp-validation-for="Condition" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Data nabycia -->
                        <div class="mb-3">
                            <label asp-for="AcquisitionDate" class="form-label fw-semibold small text-muted mb-1"></label>
                            <input asp-for="AcquisitionDate" class="form-control" type="date" />
                            <span asp-validation-for="AcquisitionDate" class="text-danger small"></span>
                        </div>

                        <!-- Uwagi -->
                        <div class="mb-4">
                            <label asp-for="Comments" class="form-label fw-semibold small text-muted mb-1"></label>
                            <textarea asp-for="Comments" class="form-control" rows="3" placeholder="Opcjonalne uwagi dotyczące wydania, oprawy lub stanu egzemplarza..."></textarea>
                            <span asp-validation-for="Comments" class="text-danger small"></span>
                        </div>

                        <!-- Przyciski akcji -->
                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-2 pt-3 border-top">
                            <a asp-controller="Books" asp-action="Details" asp-route-id="@Model.BookId" class="btn btn-outline-secondary order-2 order-sm-1">
                                <i class="bi bi-arrow-left me-1"></i>Anuluj
                            </a>
                            <button type="submit" class="btn btn-accent px-4 py-2 order-1 order-sm-2">
                                <i class="bi bi-check2-circle me-1"></i>Zapisz egzemplarz
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}