@model IEnumerable<Biblioteka.Models.Book>
@using Biblioteka.Constants
@using Biblioteka.Models

@{
    ViewData["Title"] = "Strona główna";
    int totalBooks = ViewBag.TotalBooksCount ?? 0;
    int availableCopies = ViewBag.AvailableCopiesCount ?? 0;
    int categoriesCount = ViewBag.CategoriesCount ?? 0;
    int authorsCount = ViewBag.AuthorsCount ?? 0;
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    bool isStaff = User.Identity?.IsAuthenticated == true &&
                   (User.IsInRole(UserRoles.Admin) || User.IsInRole(UserRoles.Librarian));
}

<!-- Sekcja HERO na pełną szerokość -->
<section class="hero-nordic py-5">
    <div class="container py-lg-4">
        <div class="row align-items-center g-4">
            <div class="col-12 col-lg-8">
                <span class="badge bg-accent-soft text-accent fw-bold px-3 py-2 rounded-pill mb-3">
                    <i class="bi bi-stars me-1"></i>Katalog online 24/7
                </span>
                <h1 class="display-5 fw-bold mb-3 lh-sm">
                    Odkrywaj, rezerwuj i wypożyczaj książki bez kolejek
                </h1>
                <p class="lead text-white-50 mb-4">
                    Przeszukuj cały księgozbiór biblioteki w kilka sekund, sprawdzaj dostępność egzemplarzy na żywo i zarządzaj swoimi terminami zwrotów.
                </p>

                <!-- Responsywna wyszukiwarka (stos na mobile, pasek na tablet/desktop) -->
                <form asp-controller="Books" asp-action="Index" method="get" class="hero-search-box mb-3">
                    <div class="d-flex flex-column flex-sm-row gap-2">
                        <div class="input-group flex-grow-1">
                            <span class="input-group-text bg-transparent border-0 text-muted">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" name="searchString" class="form-control"
                                   placeholder="Wpisz tytuł książki, nazwisko autora lub ISBN..."
                                   aria-label="Szukaj w katalogu" />
                        </div>
                        <button type="submit" class="btn btn-accent px-4 py-2 w-100 w-sm-auto">
                            Szukaj w katalogu
                        </button>
                    </div>
                </form>

                <!-- Szybkie filtry kategorii -->
                @if (categories.Any())
                {
                    <div class="d-flex flex-wrap align-items-center gap-2 pt-1">
                        <span class="small text-white-50 me-1">Popularne działy:</span>
                        @foreach (var cat in categories)
                        {
                            <a asp-controller="Books" asp-action="Index" asp-route-categoryId="@cat.Id" class="category-pill">
                                @cat.Name
                            </a>
                        }
                    </div>
                }
            </div>

            <!-- Karta szybkiego dostępu (na desktopie po prawej, na mobile pod wyszukiwarką) -->
            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-lg p-3 p-sm-4 text-dark">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="brand-icon-badge flex-shrink-0">
                                <i class="bi bi-person-check-fill"></i>
                            </div>
                            <div class="overflow-hidden">
                                <div class="small text-muted">Zalogowano jako</div>
                                <div class="fw-bold text-truncate">@User.Identity.Name</div>
                            </div>
                        </div>
                        <p class="small text-muted mb-3">
                            Sprawdź swoje aktywne wypożyczenia, terminy zwrotów oraz status złożonych rezerwacji.
                        </p>
                        <div class="d-grid gap-2">
                            <a asp-controller="Borrowings" asp-action="MyBorrowings" class="btn btn-primary">
                                <i class="bi bi-bookmark-heart me-2"></i>Moje wypożyczenia
                            </a>
                            @if (isStaff)
                            {
                                <a asp-controller="Borrowings" asp-action="Create" class="btn btn-outline-primary">
                                    <i class="bi bi-plus-circle me-2"></i>Wydaj książkę czytelnikowi
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="brand-icon-badge flex-shrink-0">
                                <i class="bi bi-person-plus-fill"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0">Konto czytelnika</h5>
                                <div class="small text-muted">Rezerwuj egzemplarze online</div>
                            </div>
                        </div>
                        <p class="small text-muted mb-3">
                            Zaloguj się lub załóż bezpłatne konto czytelnika, aby rezerwować wybrane książki przed wizytą w bibliotece.
                        </p>
                        <div class="d-grid gap-2">
                            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Zaloguj się
                            </a>
                            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-secondary">
                                Załóż konto czytelnika
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Pasek statystyk (2x2 na mobile, 4x1 na tablet/desktop) -->
<section class="container mt-4">
    <div class="row g-3">
        <div class="col-6 col-md-3">
            <div class="card border-0 p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary-soft rounded-3 p-2 p-sm-3 fs-4">
                        <i class="bi bi-book"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-dark lh-1">@totalBooks</div>
                        <div class="small text-muted mt-1">Tytułów w bazie</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-accent-soft rounded-3 p-2 p-sm-3 fs-4">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-dark lh-1">@availableCopies</div>
                        <div class="small text-muted mt-1">Dostępnych sztuk</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary-soft rounded-3 p-2 p-sm-3 fs-4">
                        <i class="bi bi-feather"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-dark lh-1">@authorsCount</div>
                        <div class="small text-muted mt-1">Autorów</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-accent-soft rounded-3 p-2 p-sm-3 fs-4">
                        <i class="bi bi-tags"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-dark lh-1">@categoriesCount</div>
                        <div class="small text-muted mt-1">Kategorii</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Nowości w katalogu (1 kolumna na mobile, 2 na tablet, 4 na desktop) -->
<section class="container mt-5">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-end mb-4 gap-2">
        <div>
            <span class="text-accent fw-bold small text-uppercase">Ostatnio dodane</span>
            <h2 class="fw-bold mb-0">Nowości w naszym katalogu</h2>
        </div>
        <a asp-controller="Books" asp-action="Index" class="btn btn-outline-primary btn-sm align-self-start align-self-sm-auto">
            Zobacz cały katalog <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 p-5 text-center text-muted">
            <i class="bi bi-journal-x fs-1 mb-2"></i>
            <p class="mb-0">Katalog jest obecnie pusty. Dodaj pierwsze książki z panelu bibliotekarza.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3 g-md-4">
            @foreach (var book in Model)
            {
                var availableCount = book.Copies?.Count(c => c.Status == BookStatus.Available) ?? 0;
                var totalCopiesCount = book.Copies?.Count ?? 0;

                <div class="col">
                    <div class="card card-hover h-100 d-flex flex-column">
                        <div class="book-cover-placeholder">
                            <span class="book-cover-spine"></span>
                            <div class="d-flex justify-content-between align-items-start ps-2 gap-1 position-relative" style="z-index: 2;">
                                <span class="badge bg-white text-dark shadow-sm text-truncate" style="max-width: 120px;">
                                    @(book.Categories?.FirstOrDefault()?.Name ?? book.Category?.Name ?? "Literatura")
                                </span>
                                @if (availableCount > 0)
                                {
                                    <span class="badge bg-success shadow-sm">Dostępna (@availableCount/@totalCopiesCount)</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary shadow-sm">Wypożyczona</span>
                                }
                            </div>
                            <div class="flex-grow-1 d-flex align-items-center justify-content-center ps-2 my-1">
                                @if (!string.IsNullOrWhiteSpace(book.CoverImageUrl))
                                {
                                    <img src="@book.CoverImageUrl"
                                         alt="Okładka @book.Title"
                                         class="book-cover-img"
                                         loading="lazy"
                                         onerror="this.onerror=null; this.outerHTML='<i class=\'bi bi-book text-primary opacity-50 fs-1\'></i>';" />
                                }
                                else
                                {
                                    <i class="bi bi-book text-primary opacity-50 fs-1"></i>
                                }
                            </div>
                        </div>

                        <div class="card-body d-flex flex-column flex-grow-1">
                            <h5 class="card-title fw-bold mb-1">
                                <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id"
                                   class="text-decoration-none text-dark stretched-link">
                                    @book.Title
                                </a>
                            </h5>
                            <p class="text-muted small mb-3">
                                <i class="bi bi-person me-1"></i>@(book.Author != null ? $"{book.Author.FirstName} {book.Author.LastName}" : "Autor nieznany")
                            </p>

                            <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center small">
                                <span class="text-muted">ISBN: @book.ISBN</span>
                                <span class="text-primary fw-semibold">
                                    Szczegóły <i class="bi bi-chevron-right"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>