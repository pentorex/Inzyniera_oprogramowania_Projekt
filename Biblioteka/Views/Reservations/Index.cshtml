@model IEnumerable<Biblioteka.Models.Reservation>
@using Biblioteka.Models

@{
    ViewData["Title"] = "Zarządzanie rezerwacjami";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Rezerwacje w bibliotece</h2>
            <p class="text-muted mb-0">Panel zarządzania i realizacji rezerwacji czytelników</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-bookmark-plus me-1"></i>Nowa rezerwacja
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Wyszukiwarka i filtr statusów -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-semibold small">Szukaj (tytuł, nr inwentarzowy, email)</label>
                    <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Wpisz szukaną frazę..." />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold small">Status rezerwacji</label>
                    <select name="statusFilter" class="form-select">
                        <option value="">-- Wszystkie statusy --</option>
                        <option value="Pending" selected="@(ViewBag.CurrentStatus == "Pending")">Oczekujące</option>
                        <option value="Fulfilled" selected="@(ViewBag.CurrentStatus == "Fulfilled")">Zrealizowane</option>
                        <option value="Cancelled" selected="@(ViewBag.CurrentStatus == "Cancelled")">Anulowane</option>
                        <option value="Expired" selected="@(ViewBag.CurrentStatus == "Expired")">Wygasłe</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-1"></i>Filtruj
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Lista rezerwacji -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0" id="reservationListContainer">
            <partial name="_ReservationListPartial" model="Model" />
        </div>
    </div>
</div>