@model IEnumerable<Biblioteka.Models.Reservation>
@using Biblioteka.Models

@{
    ViewData["Title"] = "Zarządzanie rezerwacjami";
}

<div class="container py-4">
    <!-- Nagłówek strony -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-primary-soft rounded-3 p-3 fs-4 d-none d-sm-flex">
                <i class="bi bi-bookmark-check"></i>
            </div>
            <div>
                <h2 class="fw-bold mb-1">Rezerwacje w bibliotece</h2>
                <p class="text-muted mb-0 small">Panel zarządzania, weryfikacji i realizacji rezerwacji czytelników</p>
            </div>
        </div>

        <a asp-action="Create" class="btn btn-accent w-100 w-sm-auto">
            <i class="bi bi-bookmark-plus me-1"></i>Nowa rezerwacja
        </a>
    </div>

    <!-- Wyszukiwarka i filtr statusów -->
    <div class="card border-0 mb-4">
        <div class="card-body p-3 p-md-4">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-12 col-md-5">
                    <label for="searchString" class="form-label fw-semibold small text-muted mb-1">
                        Szukaj rezerwacji
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted border-end-0">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="searchString" name="searchString" value="@ViewBag.CurrentSearch"
                               class="form-control border-start-0 ps-0"
                               placeholder="Tytuł książki, nr inwentarzowy lub e-mail..." />
                    </div>
                </div>

                <div class="col-12 col-sm-7 col-md-4">
                    <label for="statusFilter" class="form-label fw-semibold small text-muted mb-1">
                        Status rezerwacji
                    </label>
                    <select id="statusFilter" name="statusFilter" class="form-select">
                        <option value="">-- Wszystkie statusy --</option>
                        <option value="Pending" selected="@(ViewBag.CurrentStatus == "Pending")">Oczekujące</option>
                        <option value="Fulfilled" selected="@(ViewBag.CurrentStatus == "Fulfilled")">Zrealizowane</option>
                        <option value="Cancelled" selected="@(ViewBag.CurrentStatus == "Cancelled")">Anulowane</option>
                        <option value="Expired" selected="@(ViewBag.CurrentStatus == "Expired")">Wygasłe</option>
                    </select>
                </div>

                <div class="col-12 col-sm-5 col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-funnel me-1"></i>Filtruj
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Wyczyść filtry">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Lista rezerwacji -->
    <div id="reservationListContainer">
        <partial name="_ReservationListPartial" model="Model" />
    </div>
</div>