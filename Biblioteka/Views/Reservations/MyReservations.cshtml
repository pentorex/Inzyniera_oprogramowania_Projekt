@model IEnumerable<Biblioteka.Models.Reservation>
@using Biblioteka.Models

@{
    ViewData["Title"] = "Moje rezerwacje";
    var reservations = Model?.ToList() ?? new List<Reservation>();
    int pendingCount = reservations.Count(r => r.Status == ReservationStatus.Pending);
    int fulfilledCount = reservations.Count(r => r.Status == ReservationStatus.Fulfilled);
    int closedCount = reservations.Count(r => r.Status == ReservationStatus.Cancelled || r.Status == ReservationStatus.Expired);
}

<div class="container py-4">
    <!-- Nagłówek strony -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-primary-soft rounded-3 p-3 fs-4 d-none d-sm-flex">
                <i class="bi bi-bookmark-star"></i>
            </div>
            <div>
                <h2 class="fw-bold mb-1">Moje rezerwacje</h2>
                <p class="text-muted mb-0 small">Zarządzaj zarezerwowanymi egzemplarzami i sprawdzaj terminy odbioru</p>
            </div>
        </div>

        <a asp-action="Create" class="btn btn-accent w-100 w-sm-auto">
            <i class="bi bi-bookmark-plus me-1"></i>Nowa rezerwacja
        </a>
    </div>

    <!-- Podsumowanie liczników -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-4">
            <div class="card border-0 p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-warning-subtle text-warning-emphasis rounded-3 p-2 p-sm-3 fs-4 flex-shrink-0">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-dark lh-1">@pendingCount</div>
                        <div class="small text-muted mt-1">Oczekujące na odbiór</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-sm-4">
            <div class="card border-0 p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-success-subtle text-success rounded-3 p-2 p-sm-3 fs-4 flex-shrink-0">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-success lh-1">@fulfilledCount</div>
                        <div class="small text-muted mt-1">Zrealizowane</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-sm-4">
            <div class="card border-0 p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary-soft rounded-3 p-2 p-sm-3 fs-4 flex-shrink-0">
                        <i class="bi bi-archive"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-primary lh-1">@closedCount</div>
                        <div class="small text-muted mt-1">Zakończone / wygasłe</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (!reservations.Any())
    {
        <div class="card border-0 p-5 text-center text-muted">
            <i class="bi bi-bookmark fs-1 d-block mb-2 text-primary opacity-50"></i>
            <h5 class="fw-bold text-dark">Brak rezerwacji</h5>
            <p class="small mb-3">Nie masz jeszcze żadnych zarezerwowanych egzemplarzy na swoim koncie.</p>
            <div>
                <a asp-controller="Books" asp-action="Index" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-search me-1"></i>Przeglądaj katalog książek
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Widok kart na urządzenia mobilne i tablety (< lg) -->
        <div class="d-lg-none d-flex flex-column gap-3">
            @foreach (var item in reservations)
            {
                var book = item.BookCopy?.Book;
                var authorName = book?.Author != null
                ? $"{book.Author.FirstName} {book.Author.LastName}"
                : "Autor nieznany";
                bool isExpiredPending = item.Status == ReservationStatus.Pending && item.ExpiryDate < DateTime.UtcNow;
                var borderClass = item.Status switch
                {
                    ReservationStatus.Pending => isExpiredPending ? "border-danger" : "border-warning",
                    ReservationStatus.Fulfilled => "border-success",
                    ReservationStatus.Expired => "border-danger",
                    _ => "border-secondary"
                };

                <div class="card border-0 border-start border-4 @borderClass">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <div>
                                @if (book != null)
                                {
                                    <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id"
                                       class="fw-bold text-decoration-none text-dark d-block">
                                        @book.Title
                                    </a>
                                }
                                else
                                {
                                    <span class="fw-bold text-muted">Nieznany tytuł</span>
                                }
                                <div class="small text-muted">@authorName</div>
                            </div>

                            <code class="small fw-semibold text-primary bg-primary-soft px-2 py-1 rounded flex-shrink-0">
                                @(item.BookCopy?.InventoryNumber ?? $"#{item.BookCopyId}")
                            </code>
                        </div>

                        <div class="row g-2 small py-2 border-top border-bottom my-2">
                            <div class="col-6">
                                <span class="text-muted d-block">Data rezerwacji</span>
                                <span class="fw-semibold">@item.ReservationDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                            </div>
                            <div class="col-6">
                                <span class="text-muted d-block">Ważna do</span>
                                <span class="fw-bold @(isExpiredPending ? "text-danger" : "text-dark")">
                                    @item.ExpiryDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </span>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-1">
                            <div>
                                @switch (item.Status)
                                {
                                    case ReservationStatus.Pending:
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-hourglass-split me-1"></i>Oczekuje na odbiór
                                        </span>
                                        break;
                                    case ReservationStatus.Fulfilled:
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-check-circle me-1"></i>Zrealizowana (Wypożyczono)
                                        </span>
                                        break;
                                    case ReservationStatus.Cancelled:
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                            <i class="bi bi-x-circle me-1"></i>Anulowana
                                        </span>
                                        break;
                                    case ReservationStatus.Expired:
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                            <i class="bi bi-clock-history me-1"></i>Wygasła
                                        </span>
                                        break;
                                }
                            </div>

                            @if (item.Status == ReservationStatus.Pending)
                            {
                                <form asp-action="Cancel" asp-route-id="@item.Id" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Czy na pewno chcesz anulować tę rezerwację?');">
                                        <i class="bi bi-x-circle me-1"></i>Anuluj
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Widok tabeli na większe ekrany (>= lg) -->
        <div class="card border-0 d-none d-lg-block">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Książka</th>
                            <th>Nr inwentarzowy</th>
                            <th>Data rezerwacji</th>
                            <th>Ważna do</th>
                            <th>Status</th>
                            <th class="text-end">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in reservations)
                        {
                            var book = item.BookCopy?.Book;
                            var authorName = book?.Author != null
                            ? $"{book.Author.FirstName} {book.Author.LastName}"
                            : "Nieznany";
                            bool isExpiredPending = item.Status == ReservationStatus.Pending && item.ExpiryDate < DateTime.UtcNow;

                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrWhiteSpace(book?.CoverImageUrl))
                                        {
                                            <img src="@book.CoverImageUrl" alt="" class="rounded border"
                                                 style="width: 34px; height: 48px; object-fit: cover;"
                                                 onerror="this.style.display='none'" />
                                        }
                                        else
                                        {
                                            <div class="bg-primary-soft rounded d-flex align-items-center justify-content-center flex-shrink-0"
                                                 style="width: 34px; height: 48px;">
                                                <i class="bi bi-book"></i>
                                            </div>
                                        }
                                        <div>
                                            @if (book != null)
                                            {
                                                <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id"
                                                   class="fw-bold text-decoration-none text-dark d-block">
                                                    @book.Title
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="fw-bold text-muted">Nieznany tytuł</span>
                                            }
                                            <span class="small text-muted">@authorName</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <code class="fw-semibold text-primary bg-primary-soft px-2 py-1 rounded">
                                        @(item.BookCopy?.InventoryNumber ?? $"#{item.BookCopyId}")
                                    </code>
                                </td>
                                <td>@item.ReservationDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="fw-semibold @(isExpiredPending ? "text-danger" : "")">
                                    @item.ExpiryDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case ReservationStatus.Pending:
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-hourglass-split me-1"></i>Oczekuje na odbiór
                                            </span>
                                            break;
                                        case ReservationStatus.Fulfilled:
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                <i class="bi bi-check-circle me-1"></i>Zrealizowana (Wypożyczono)
                                            </span>
                                            break;
                                        case ReservationStatus.Cancelled:
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                                <i class="bi bi-x-circle me-1"></i>Anulowana
                                            </span>
                                            break;
                                        case ReservationStatus.Expired:
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                                <i class="bi bi-clock-history me-1"></i>Wygasła
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="text-end">
                                    @if (item.Status == ReservationStatus.Pending)
                                    {
                                        <form asp-action="Cancel" asp-route-id="@item.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Czy na pewno chcesz anulować tę rezerwację?');">
                                                <i class="bi bi-x-circle me-1"></i>Anuluj
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>