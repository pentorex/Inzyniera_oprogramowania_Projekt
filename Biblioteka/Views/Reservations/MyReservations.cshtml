@model IEnumerable<Biblioteka.Models.Reservation>
@using Biblioteka.Models

@{
    ViewData["Title"] = "Moje rezerwacje";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Moje rezerwacje</h2>
            <p class="text-muted mb-0">Zarządzaj swoimi zarezerwowanymi egzemplarzami książek</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-bookmark-plus me-1"></i>Nowa rezerwacja
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tytuł książki</th>
                            <th>Autor</th>
                            <th>Nr inwentarzowy</th>
                            <th>Data rezerwacji</th>
                            <th>Ważna do</th>
                            <th>Status</th>
                            <th class="text-end">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-bookmark fs-1 d-block mb-2"></i>
                                    Nie masz jeszcze żadnych rezerwacji.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>@item.BookCopy?.Book?.Title</strong></td>
                                    <td>
                                        @(item.BookCopy?.Book?.Author != null
                                                                        ? $"{item.BookCopy.Book.Author.FirstName} {item.BookCopy.Book.Author.LastName}"
                                                                        : "Nieznany")
                            </td>
                            <td><code>@item.BookCopy?.InventoryNumber</code></td>
                            <td>@item.ReservationDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                @item.ExpiryDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </td>
                            <td>
                                @switch (item.Status)
                                        {
                                            case ReservationStatus.Pending:
                                                <span class="badge bg-warning text-dark">Oczekuje na odbiór</span>
                                                break;
                                            case ReservationStatus.Fulfilled:
                                                <span class="badge bg-success">Zrealizowana (Wypożyczono)</span>
                                                break;
                                            case ReservationStatus.Cancelled:
                                                <span class="badge bg-secondary">Anulowana</span>
                                                break;
                                            case ReservationStatus.Expired:
                                                <span class="badge bg-danger">Wygasła</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (item.Status == ReservationStatus.Pending)
                                        {
                                            <form asp-action="Cancel" asp-route-id="@item.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Czy na pewno chcesz anulować tę rezerwację?');">
                                                    <i class="bi bi-x-circle me-1"></i>Anuluj
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>