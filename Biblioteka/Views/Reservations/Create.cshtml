@model Biblioteka.Models.Reservation

@{
    ViewData["Title"] = "Nowa rezerwacja";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-9 col-lg-6">
            <div class="card border-0">
                <div class="card-body p-3 p-sm-4 p-md-5">
                    <!-- Nagłówek formularza -->
                    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                        <div class="bg-primary-soft rounded-3 p-3 fs-4 flex-shrink-0">
                            <i class="bi bi-bookmark-plus"></i>
                        </div>
                        <div>
                            <h2 class="h4 fw-bold mb-1">Zarezerwuj egzemplarz</h2>
                            <p class="text-muted mb-0 small">Wybierz dostępny egzemplarz książki do rezerwacji</p>
                        </div>
                    </div>

                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="BookCopyId" class="form-label fw-semibold small text-muted mb-1"></label>
                            <select asp-for="BookCopyId" class="form-select" asp-items="ViewBag.BookCopyId">
                                <option value="">-- Wybierz egzemplarz z listy --</option>
                            </select>
                            <span asp-validation-for="BookCopyId" class="text-danger small"></span>
                        </div>

                        <!-- Informacja o zasadach rezerwacji -->
                        <div class="bg-primary-soft rounded-3 p-3 mt-3 small d-flex align-items-start gap-2">
                            <i class="bi bi-info-circle-fill fs-5 flex-shrink-0 mt-1"></i>
                            <div>
                                <strong>Ważność rezerwacji: 3 dni.</strong>
                                Po tym czasie, jeśli książka nie zostanie odebrana w bibliotece, egzemplarz automatycznie wróci do puli dostępnych.
                            </div>
                        </div>

                        <!-- Przyciski akcji -->
                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-2 mt-4 pt-2">
                            <a asp-action="MyReservations" class="btn btn-outline-secondary order-2 order-sm-1">
                                <i class="bi bi-arrow-left me-1"></i>Moje rezerwacje
                            </a>
                            <button type="submit" class="btn btn-accent px-4 py-2 order-1 order-sm-2">
                                <i class="bi bi-check2-circle me-1"></i>Zatwierdź rezerwację
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}