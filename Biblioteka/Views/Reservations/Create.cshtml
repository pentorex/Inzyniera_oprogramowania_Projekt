@model Biblioteka.Models.Reservation

@{
    ViewData["Title"] = "Nowa rezerwacja";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4">
                        <div class="bg-primary text-white rounded-3 p-3 me-3">
                            <i class="bi bi-bookmark-plus fs-4"></i>
                        </div>
                        <div>
                            <h2 class="fw-bold mb-1">Zarezerwuj egzemplarz</h2>
                            <p class="text-muted mb-0">Wybierz dostępny egzemplarz książki do rezerwacji</p>
                        </div>
                    </div>

                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="BookCopyId" class="form-label fw-bold"></label>
                            <select asp-for="BookCopyId" class="form-select" asp-items="ViewBag.BookCopyId">
                                <option value="">-- Wybierz egzemplarz z listy --</option>
                            </select>
                            <span asp-validation-for="BookCopyId" class="text-danger"></span>
                            <div class="form-text mt-2">
                                <i class="bi bi-info-circle me-1"></i> Rezerwacja jest ważna przez 3 dni. Po tym czasie, jeśli nie zostanie odebrana, egzemplarz automatycznie wróci do puli dostępnych.
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a asp-action="MyReservations" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Powrót do moich rezerwacji
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-lg me-1"></i>Zatwierdź rezerwację
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}