@model IEnumerable<Biblioteka.Models.Author>

@{
    ViewData["Title"] = "Zarządzanie Autorami";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-person-lines-fill me-2 text-primary"></i>Autorzy</h2>
            <p class="text-muted mb-0">Zarządzanie twórcami pozycji bibliotecznych</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Dodaj autora
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Nazwisko i Imię</th>
                            <th>Liczba pozycji w katalogu</th>
                            <th class="text-end">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center py-4 text-muted">Brak autorów w bazie.</td>
                            </tr>
                        }
                        @foreach (var author in Model)
                        {
                            var bookCount = author.Books?.Count ?? 0;
                            <tr>
                                <td>
                                    <strong>@author.LastName @author.FirstName</strong>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@bookCount pozycji</span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@author.Id" class="btn btn-sm btn-outline-primary me-1">
                                        <i class="bi bi-pencil me-1"></i>Edytuj
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@author.Id" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash me-1"></i>Usuń
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>