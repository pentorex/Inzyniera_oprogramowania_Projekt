@model IEnumerable<Biblioteka.Models.Author>

@{
    ViewData["Title"] = "Zarządzanie Autorami";
    var authorsList = Model?.ToList() ?? new List<Biblioteka.Models.Author>();
}

<div class="container py-4">
    <!-- Nagłówek strony -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-primary-soft rounded-3 p-3 fs-4 d-none d-sm-flex">
                <i class="bi bi-feather"></i>
            </div>
            <div>
                <h2 class="fw-bold mb-1">Autorzy</h2>
                <p class="text-muted mb-0 small">Zarządzanie twórcami pozycji bibliotecznych w katalogu</p>
            </div>
        </div>

        <a asp-action="Create" class="btn btn-accent w-100 w-sm-auto">
            <i class="bi bi-plus-lg me-1"></i>Dodaj autora
        </a>
    </div>

    <!-- Komunikaty zwrotne kontrolera -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zamknij"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zamknij"></button>
        </div>
    }

    <!-- Pasek szybkiego filtrowania -->
    <div class="card border-0 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-6 col-lg-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted border-end-0">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="authorQuickFilter" class="form-control border-start-0 ps-0"
                               placeholder="Filtruj po nazwisku lub imieniu..." autocomplete="off" />
                    </div>
                </div>
                <div class="col-12 col-md-6 col-lg-7 text-md-end">
                    <span class="text-muted small">
                        Liczba autorów: <strong class="text-dark" id="authorsVisibleCount">@authorsList.Count</strong>
                    </span>
                </div>
            </div>
        </div>
    </div>

    @if (!authorsList.Any())
    {
        <div class="card border-0 p-5 text-center text-muted">
            <i class="bi bi-person-x fs-1 d-block mb-2 text-primary opacity-50"></i>
            <h5 class="fw-bold text-dark">Brak autorów w bazie</h5>
            <p class="small mb-3">Nie dodano jeszcze żadnego twórcy do systemu bibliotecznego.</p>
            <div>
                <a asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-lg me-1"></i>Dodaj pierwszego autora
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Komunikat braku wyników filtrowania -->
        <div id="noFilterMatches" class="card border-0 p-5 text-center text-muted d-none">
            <i class="bi bi-search fs-1 d-block mb-2 text-primary opacity-50"></i>
            <h6 class="fw-bold text-dark mb-1">Brak dopasowań</h6>
            <p class="small mb-0">Nie znaleziono autora pasującego do wpisanej frazy.</p>
        </div>

        <!-- Widok kart na urządzenia mobilne (< md) -->
        <div class="d-md-none d-flex flex-column gap-3" id="authorsMobileList">
            @foreach (var author in authorsList)
            {
                var bookCount = author.Books?.Count ?? 0;
                var firstInitial = !string.IsNullOrWhiteSpace(author.FirstName) ? author.FirstName.Trim()[0].ToString().ToUpper() : "";
                var lastInitial = !string.IsNullOrWhiteSpace(author.LastName) ? author.LastName.Trim()[0].ToString().ToUpper() : "";
                var initials = string.IsNullOrEmpty($"{lastInitial}{firstInitial}") ? "?" : $"{lastInitial}{firstInitial}";
                var fullName = $"{author.LastName} {author.FirstName}".Trim();
                string countLabel = bookCount == 1
                ? "1 pozycja"
                : (bookCount % 10 >= 2 && bookCount % 10 <= 4 && (bookCount % 100 < 10 || bookCount % 100 >= 20)
                ? $"{bookCount} pozycje"
                : $"{bookCount} pozycji");

                <div class="card border-0 author-item" data-author-name="@fullName.ToLower()">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
                            <div class="d-flex align-items-center gap-3 overflow-hidden">
                                <div class="bg-primary-soft rounded-circle d-flex align-items-center justify-content-center fw-bold flex-shrink-0"
                                     style="width: 42px; height: 42px;">
                                    @initials
                                </div>
                                <div class="overflow-hidden">
                                    <div class="fw-bold text-dark text-truncate">@fullName</div>
                                    <a asp-controller="Books" asp-action="Index" asp-route-authorId="@author.Id"
                                       class="badge bg-primary-soft text-decoration-none mt-1">
                                        <i class="bi bi-book me-1"></i>@countLabel
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 pt-2 border-top">
                            <a asp-action="Edit" asp-route-id="@author.Id" class="btn btn-sm btn-outline-primary flex-grow-1">
                                <i class="bi bi-pencil me-1"></i>Edytuj
                            </a>
                            <a asp-action="Delete" asp-route-id="@author.Id" class="btn btn-sm btn-outline-danger flex-grow-1">
                                <i class="bi bi-trash me-1"></i>Usuń
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Widok tabeli na tablety i komputery (>= md) -->
        <div class="card border-0 d-none d-md-block" id="authorsDesktopCard">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Nazwisko i imię</th>
                            <th>Pozycje w katalogu</th>
                            <th class="text-end">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var author in authorsList)
                        {
                            var bookCount = author.Books?.Count ?? 0;
                            var firstInitial = !string.IsNullOrWhiteSpace(author.FirstName) ? author.FirstName.Trim()[0].ToString().ToUpper() : "";
                            var lastInitial = !string.IsNullOrWhiteSpace(author.LastName) ? author.LastName.Trim()[0].ToString().ToUpper() : "";
                            var initials = string.IsNullOrEmpty($"{lastInitial}{firstInitial}") ? "?" : $"{lastInitial}{firstInitial}";
                            var fullName = $"{author.LastName} {author.FirstName}".Trim();
                            string countLabel = bookCount == 1
                            ? "1 pozycja"
                            : (bookCount % 10 >= 2 && bookCount % 10 <= 4 && (bookCount % 100 < 10 || bookCount % 100 >= 20)
                            ? $"{bookCount} pozycje"
                            : $"{bookCount} pozycji");

                            <tr class="author-item" data-author-name="@fullName.ToLower()">
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-primary-soft rounded-circle d-flex align-items-center justify-content-center fw-bold flex-shrink-0"
                                             style="width: 38px; height: 38px; font-size: 0.85rem;">
                                            @initials
                                        </div>
                                        <strong class="text-dark">@fullName</strong>
                                    </div>
                                </td>
                                <td>
                                    <a asp-controller="Books" asp-action="Index" asp-route-authorId="@author.Id"
                                       class="badge bg-primary-soft text-decoration-none px-3 py-2"
                                       title="Pokaż książki tego autora w katalogu">
                                        <i class="bi bi-book me-1"></i>@countLabel
                                    </a>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@author.Id" class="btn btn-sm btn-outline-primary me-1">
                                        <i class="bi bi-pencil me-1"></i>Edytuj
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@author.Id" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash me-1"></i>Usuń
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const filterInput = document.getElementById("authorQuickFilter");
            const countLabel = document.getElementById("authorsVisibleCount");
            const noMatches = document.getElementById("noFilterMatches");
            const desktopCard = document.getElementById("authorsDesktopCard");
            const mobileList = document.getElementById("authorsMobileList");

            if (!filterInput) return;

            filterInput.addEventListener("input", function () {
                const query = this.value.trim().toLowerCase();
                let visibleDesktop = 0;

                document.querySelectorAll("#authorsDesktopCard .author-item").forEach(row => {
                    const name = row.getAttribute("data-author-name") || "";
                    const match = name.includes(query);
                    row.classList.toggle("d-none", !match);
                    if (match) visibleDesktop++;
                });

                document.querySelectorAll("#authorsMobileList .author-item").forEach(card => {
                    const name = card.getAttribute("data-author-name") || "";
                    const match = name.includes(query);
                    card.classList.toggle("d-none", !match);
                });

                if (countLabel) {
                    countLabel.textContent = visibleDesktop;
                }

                if (noMatches) {
                    const isEmpty = visibleDesktop === 0;
                    noMatches.classList.toggle("d-none", !isEmpty);
                    if (desktopCard) desktopCard.classList.toggle("d-md-none", isEmpty);
                    if (mobileList) mobileList.classList.toggle("d-none", isEmpty);
                }
            });
        });
    </script>
}