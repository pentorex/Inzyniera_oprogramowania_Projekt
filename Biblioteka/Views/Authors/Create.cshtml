@model Biblioteka.Models.Author

@{
    ViewData["Title"] = "Dodaj Autora";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-0">
                <div class="card-body p-3 p-sm-4 p-md-5">
                    <!-- Nagłówek formularza -->
                    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                        <div class="bg-primary-soft rounded-3 p-3 fs-4 flex-shrink-0">
                            <i class="bi bi-person-plus"></i>
                        </div>
                        <div>
                            <h2 class="h4 fw-bold mb-1">Dodaj nowego autora</h2>
                            <p class="text-muted mb-0 small">Wprowadź dane twórcy, aby przypisywać do niego książki w katalogu</p>
                        </div>
                    </div>

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 py-2 small"></div>

                        <div class="mb-3">
                            <label asp-for="FirstName" class="form-label fw-semibold small text-muted mb-1">Imię</label>
                            <input asp-for="FirstName" class="form-control" placeholder="Wprowadź imię..." />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="LastName" class="form-label fw-semibold small text-muted mb-1">Nazwisko</label>
                            <input asp-for="LastName" class="form-control" placeholder="Wprowadź nazwisko..." />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>

                        <!-- Przyciski akcji -->
                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-2 mt-4 pt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary order-2 order-sm-1">
                                <i class="bi bi-arrow-left me-1"></i>Wróć do listy
                            </a>
                            <button type="submit" class="btn btn-accent px-4 py-2 order-1 order-sm-2">
                                <i class="bi bi-check2-circle me-1"></i>Zapisz autora
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}