@model IEnumerable<Biblioteka.Models.UserListItemViewModel>

@{
    ViewData["Title"] = "Zarządzanie Użytkownikami";
    var usersList = Model?.ToList() ?? new List<Biblioteka.Models.UserListItemViewModel>();
    int totalUsers = usersList.Count;
    int activeUsers = usersList.Count(u => u.IsActive);
    int blockedUsers = usersList.Count(u => !u.IsActive);
    var allRoles = usersList
        .SelectMany(u => u.Roles ?? Enumerable.Empty<string>())
        .Distinct()
        .OrderBy(r => r)
        .ToList();
}

<div class="container py-4">
    <!-- Nagłówek strony -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-primary-soft rounded-3 p-3 fs-4 d-none d-sm-flex">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <h2 class="fw-bold mb-1">Zarządzanie użytkownikami</h2>
                <p class="text-muted mb-0 small">Przegląd kont czytelników, bibliotekarzy oraz zarządzanie uprawnieniami</p>
            </div>
        </div>
    </div>

    <!-- Podsumowanie liczników -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-4">
            <div class="card border-0 p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary-soft rounded-3 p-2 p-sm-3 fs-4 flex-shrink-0">
                        <i class="bi bi-people"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-dark lh-1">@totalUsers</div>
                        <div class="small text-muted mt-1">Wszystkie konta</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-sm-4">
            <div class="card border-0 p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-success-subtle text-success rounded-3 p-2 p-sm-3 fs-4 flex-shrink-0">
                        <i class="bi bi-person-check"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-success lh-1">@activeUsers</div>
                        <div class="small text-muted mt-1">Aktywne konta</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-sm-4">
            <div class="card border-0 p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-danger-subtle text-danger rounded-3 p-2 p-sm-3 fs-4 flex-shrink-0">
                        <i class="bi bi-person-lock"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-danger lh-1">@blockedUsers</div>
                        <div class="small text-muted mt-1">Zablokowane konta</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Pasek szybkiego filtrowania -->
    <div class="card border-0 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-5 col-lg-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted border-end-0">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="userQuickFilter" class="form-control border-start-0 ps-0"
                               placeholder="Szukaj po imieniu, nazwisku lub e-mailu..." autocomplete="off" />
                    </div>
                </div>

                <div class="col-6 col-md-3 col-lg-2">
                    <select id="userRoleFilter" class="form-select" aria-label="Filtruj według roli">
                        <option value="">Wszystkie role</option>
                        @foreach (var role in allRoles)
                        {
                            <option value="@role.ToLower()">@role</option>
                        }
                    </select>
                </div>

                <div class="col-6 col-md-2 col-lg-2">
                    <select id="userStatusFilter" class="form-select" aria-label="Filtruj według statusu">
                        <option value="">Wszystkie statusy</option>
                        <option value="active">Aktywne</option>
                        <option value="blocked">Zablokowane</option>
                    </select>
                </div>

                <div class="col-12 col-md-2 col-lg-3 text-md-end">
                    <span class="text-muted small">
                        Widoczne konta: <strong class="text-dark" id="usersVisibleCount">@totalUsers</strong>
                    </span>
                </div>
            </div>
        </div>
    </div>

    @if (!usersList.Any())
    {
        <div class="card border-0 p-5 text-center text-muted">
            <i class="bi bi-people fs-1 d-block mb-2 text-primary opacity-50"></i>
            <h5 class="fw-bold text-dark">Brak użytkowników w systemie</h5>
            <p class="small mb-0">Nie zarejestrowano jeszcze żadnych kont użytkowników.</p>
        </div>
    }
    else
    {
        <!-- Komunikat braku wyników filtrowania -->
        <div id="noFilterMatches" class="card border-0 p-5 text-center text-muted d-none">
            <i class="bi bi-search fs-1 d-block mb-2 text-primary opacity-50"></i>
            <h6 class="fw-bold text-dark mb-1">Brak dopasowań</h6>
            <p class="small mb-0">Nie znaleziono użytkownika spełniającego wybrane kryteria.</p>
        </div>

        <!-- Widok kart na urządzenia mobilne i tablety (< lg) -->
        <div class="d-lg-none d-flex flex-column gap-3" id="usersMobileList">
            @foreach (var user in usersList)
            {
                var fullName = $"{user.FirstName} {user.LastName}".Trim();
                var displayName = string.IsNullOrWhiteSpace(fullName) ? user.Email : fullName;
                var firstInitial = !string.IsNullOrWhiteSpace(user.FirstName) ? user.FirstName.Trim()[0].ToString().ToUpper() : "";
                var lastInitial = !string.IsNullOrWhiteSpace(user.LastName) ? user.LastName.Trim()[0].ToString().ToUpper() : "";
                var initials = !string.IsNullOrEmpty($"{firstInitial}{lastInitial}")
                ? $"{firstInitial}{lastInitial}"
                : (!string.IsNullOrWhiteSpace(user.Email) ? user.Email.Trim()[0].ToString().ToUpper() : "?");

                var roles = user.Roles?.ToList() ?? new List<string>();
                var searchData = $"{fullName} {user.Email}".ToLower();
                var rolesData = string.Join(",", roles.Select(r => r.ToLower()));
                var statusData = user.IsActive ? "active" : "blocked";

                <div class="card border-0 border-start border-4 @(user.IsActive ? "border-success" : "border-danger") user-item"
                     data-user-search="@searchData"
                     data-user-roles="@rolesData"
                     data-user-status="@statusData">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <div class="d-flex align-items-center gap-3 overflow-hidden">
                                <div class="bg-primary-soft rounded-circle d-flex align-items-center justify-content-center fw-bold flex-shrink-0"
                                     style="width: 42px; height: 42px;">
                                    @initials
                                </div>
                                <div class="overflow-hidden">
                                    <div class="fw-bold text-dark text-truncate">@displayName</div>
                                    <div class="small text-muted text-truncate">@user.Email</div>
                                </div>
                            </div>

                            @if (user.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle flex-shrink-0">
                                    <i class="bi bi-check-circle me-1"></i>Aktywne
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle flex-shrink-0">
                                    <i class="bi bi-lock-fill me-1"></i>Zablokowane
                                </span>
                            }
                        </div>

                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 py-2 border-top border-bottom my-2 small">
                            <div class="text-muted">
                                <i class="bi bi-calendar3 me-1"></i>@user.RegistrationDate.ToString("dd.MM.yyyy HH:mm")
                            </div>
                            <div class="d-flex flex-wrap gap-1">
                                @if (roles.Any())
                                {
                                    foreach (var role in roles)
                                    {
                                        var badgeClass = role switch
                                        {
                                            "Admin" => "bg-danger-subtle text-danger border border-danger-subtle",
                                            "Librarian" => "bg-primary-soft",
                                            _ => "bg-secondary-subtle text-secondary border border-secondary-subtle"
                                        };
                                        <span class="badge @badgeClass">@role</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">Brak ról</span>
                                }
                            </div>
                        </div>

                        <div class="d-flex gap-2 pt-1">
                            <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary flex-grow-1">
                                <i class="bi bi-pencil me-1"></i>Edytuj
                            </a>
                            <form asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" class="flex-grow-1 m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm w-100 @(user.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                    <i class="bi @(user.IsActive ? "bi-lock" : "bi-unlock") me-1"></i>
                                    @(user.IsActive ? "Zablokuj" : "Odblokuj")
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Widok tabeli na większe ekrany (>= lg) -->
        <div class="card border-0 d-none d-lg-block" id="usersDesktopCard">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Użytkownik</th>
                            <th>E-mail</th>
                            <th>Data rejestracji</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th class="text-end">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in usersList)
                        {
                            var fullName = $"{user.FirstName} {user.LastName}".Trim();
                            var displayName = string.IsNullOrWhiteSpace(fullName) ? "Brak imienia i nazwiska" : fullName;
                            var firstInitial = !string.IsNullOrWhiteSpace(user.FirstName) ? user.FirstName.Trim()[0].ToString().ToUpper() : "";
                            var lastInitial = !string.IsNullOrWhiteSpace(user.LastName) ? user.LastName.Trim()[0].ToString().ToUpper() : "";
                            var initials = !string.IsNullOrEmpty($"{firstInitial}{lastInitial}")
                            ? $"{firstInitial}{lastInitial}"
                            : (!string.IsNullOrWhiteSpace(user.Email) ? user.Email.Trim()[0].ToString().ToUpper() : "?");

                            var roles = user.Roles?.ToList() ?? new List<string>();
                            var searchData = $"{fullName} {user.Email}".ToLower();
                            var rolesData = string.Join(",", roles.Select(r => r.ToLower()));
                            var statusData = user.IsActive ? "active" : "blocked";

                            <tr class="user-item"
                                data-user-search="@searchData"
                                data-user-roles="@rolesData"
                                data-user-status="@statusData">
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-primary-soft rounded-circle d-flex align-items-center justify-content-center fw-bold flex-shrink-0"
                                             style="width: 38px; height: 38px; font-size: 0.85rem;">
                                            @initials
                                        </div>
                                        <strong class="@(string.IsNullOrWhiteSpace(fullName) ? "text-muted fst-italic fw-normal" : "text-dark")">
                                            @displayName
                                        </strong>
                                    </div>
                                </td>
                                <td class="text-muted small">@user.Email</td>
                                <td class="small">@user.RegistrationDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    @if (roles.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var role in roles)
                                            {
                                                var badgeClass = role switch
                                                {
                                                    "Admin" => "bg-danger-subtle text-danger border border-danger-subtle",
                                                    "Librarian" => "bg-primary-soft",
                                                    _ => "bg-secondary-subtle text-secondary border border-secondary-subtle"
                                                };
                                                <span class="badge @badgeClass">@role</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-check-circle me-1"></i>Aktywne
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                            <i class="bi bi-lock-fill me-1"></i>Zablokowane
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary me-1">
                                        <i class="bi bi-pencil me-1"></i>Edytuj
                                    </a>
                                    <form asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                            <i class="bi @(user.IsActive ? "bi-lock" : "bi-unlock") me-1"></i>
                                            @(user.IsActive ? "Zablokuj" : "Odblokuj")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("userQuickFilter");
            const roleSelect = document.getElementById("userRoleFilter");
            const statusSelect = document.getElementById("userStatusFilter");
            const countLabel = document.getElementById("usersVisibleCount");
            const noMatches = document.getElementById("noFilterMatches");
            const desktopCard = document.getElementById("usersDesktopCard");
            const mobileList = document.getElementById("usersMobileList");

            if (!searchInput) return;

            function applyFilters() {
                const query = searchInput.value.trim().toLowerCase();
                const selectedRole = roleSelect ? roleSelect.value : "";
                const selectedStatus = statusSelect ? statusSelect.value : "";
                let visibleDesktop = 0;

                function matchesElement(el) {
                    const text = el.getAttribute("data-user-search") || "";
                    const roles = (el.getAttribute("data-user-roles") || "").split(",");
                    const status = el.getAttribute("data-user-status") || "";

                    const textMatch = text.includes(query);
                    const roleMatch = !selectedRole || roles.includes(selectedRole);
                    const statusMatch = !selectedStatus || status === selectedStatus;

                    return textMatch && roleMatch && statusMatch;
                }

                document.querySelectorAll("#usersDesktopCard .user-item").forEach(row => {
                    const match = matchesElement(row);
                    row.classList.toggle("d-none", !match);
                    if (match) visibleDesktop++;
                });

                document.querySelectorAll("#usersMobileList .user-item").forEach(card => {
                    const match = matchesElement(card);
                    card.classList.toggle("d-none", !match);
                });

                if (countLabel) {
                    countLabel.textContent = visibleDesktop;
                }

                if (noMatches) {
                    const isEmpty = visibleDesktop === 0;
                    noMatches.classList.toggle("d-none", !isEmpty);
                    if (desktopCard) desktopCard.classList.toggle("d-lg-none", isEmpty);
                    if (mobileList) mobileList.classList.toggle("d-none", isEmpty);
                }
            }

            searchInput.addEventListener("input", applyFilters);
            if (roleSelect) roleSelect.addEventListener("change", applyFilters);
            if (statusSelect) statusSelect.addEventListener("change", applyFilters);
        });
    </script>
}