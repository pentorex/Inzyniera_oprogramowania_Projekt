@model Biblioteka.Models.EditUserViewModel

@{
    ViewData["Title"] = "Edycja Użytkownika";
}

<div class="container py-4">
    <!-- Nawigacja okruszkowa -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item">
                <a asp-action="Index" class="text-decoration-none">Lista użytkowników</a>
            </li>
            <li class="breadcrumb-item active text-truncate" style="max-width: 240px;" aria-current="page">
                @Model.Email
            </li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card border-0">
                <div class="card-body p-3 p-sm-4 p-md-5">
                    <!-- Nagłówek formularza -->
                    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                        <div class="bg-primary-soft rounded-3 p-3 fs-4 flex-shrink-0">
                            <i class="bi bi-person-gear"></i>
                        </div>
                        <div class="overflow-hidden">
                            <h2 class="h4 fw-bold mb-1">Edycja użytkownika</h2>
                            <p class="text-muted mb-0 small text-truncate">@Model.Email</p>
                        </div>
                    </div>

                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 py-2 small mb-3"></div>

                        <!-- Imię i Nazwisko -->
                        <div class="row g-3 mb-3">
                            <div class="col-12 col-sm-6">
                                <label asp-for="FirstName" class="form-label fw-semibold small text-muted mb-1"></label>
                                <input asp-for="FirstName" class="form-control" placeholder="Wprowadź imię..." />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label asp-for="LastName" class="form-label fw-semibold small text-muted mb-1"></label>
                                <input asp-for="LastName" class="form-control" placeholder="Wprowadź nazwisko..." />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- E-mail i Telefon -->
                        <div class="row g-3 mb-4">
                            <div class="col-12 col-sm-6">
                                <label asp-for="Email" class="form-label fw-semibold small text-muted mb-1"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white text-muted border-end-0">
                                        <i class="bi bi-envelope"></i>
                                    </span>
                                    <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="adres@domena.pl" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label asp-for="PhoneNumber" class="form-label fw-semibold small text-muted mb-1"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white text-muted border-end-0">
                                        <i class="bi bi-telephone"></i>
                                    </span>
                                    <input asp-for="PhoneNumber" class="form-control border-start-0 ps-0" placeholder="+48 000 000 000" />
                                </div>
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Status konta -->
                        <div class="bg-light border rounded-3 p-3 mb-4">
                            <div class="form-check form-switch d-flex align-items-center justify-content-between ps-0 mb-0">
                                <div class="pe-3">
                                    <label class="form-check-label fw-bold text-dark d-block" asp-for="IsActive">
                                        Konto aktywne
                                    </label>
                                    <span class="text-muted small">
                                        Wyłączenie blokuje możliwość logowania się użytkownika do systemu bibliotecznego.
                                    </span>
                                </div>
                                <input class="form-check-input ms-0 fs-5 flex-shrink-0" type="checkbox" role="switch" asp-for="IsActive">
                            </div>
                        </div>

                        <!-- Przypisane role systemowe -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold small text-muted d-block mb-2">
                                Przypisane role systemowe
                            </label>
                            <div class="row g-2">
                                @if (Model.AvailableRoles != null && Model.AvailableRoles.Any())
                                {
                                    @foreach (var role in Model.AvailableRoles)
                                    {
                                        var isChecked = Model.SelectedRoles != null && Model.SelectedRoles.Contains(role);
                                        var roleIcon = role switch
                                        {
                                            "Admin" => "bi-shield-lock-fill",
                                            "Librarian" => "bi-book-half",
                                            _ => "bi-person-badge"
                                        };

                                        <div class="col-12 col-sm-6 col-md-4">
                                            <label class="border rounded-3 p-3 d-flex align-items-center gap-2 bg-white w-100 h-100"
                                                   for="role_@role" style="cursor: pointer;">
                                                <input class="form-check-input mt-0 flex-shrink-0"
                                                       type="checkbox"
                                                       name="SelectedRoles"
                                                       value="@role"
                                                       id="role_@role"
                                                       @(isChecked ? "checked" : "") />
                                                <i class="bi @roleIcon text-primary"></i>
                                                <span class="fw-semibold text-dark small">@role</span>
                                            </label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="col-12">
                                        <span class="text-muted small">Brak zdefiniowanych ról w systemie.</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Przyciski akcji -->
                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-2 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary order-2 order-sm-1">
                                <i class="bi bi-arrow-left me-1"></i>Powrót do listy
                            </a>
                            <button type="submit" class="btn btn-accent px-4 py-2 order-1 order-sm-2">
                                <i class="bi bi-check2-circle me-1"></i>Zapisz zmiany
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}