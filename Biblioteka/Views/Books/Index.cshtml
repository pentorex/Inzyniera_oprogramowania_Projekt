@model IEnumerable<Biblioteka.Models.Book>

@{
    ViewData["Title"] = "Katalog Książek";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Katalog Książek</h1>
        @if (User.IsInRole("Administrator") || User.IsInRole("Bibliotekarz"))
        {
            <a asp-action="Create" class="btn btn-success">+ Dodaj nową książkę</a>
        }
    </div>

    <!-- Wyszukiwarka -->
    <form asp-action="Index" method="get" class="mb-4">
        <div class="input-group">
            <input type="text" name="searchString" class="form-control" placeholder="Szukaj po tytule lub nazwisku autora..." />
            <button type="submit" class="btn btn-outline-primary">Szukaj</button>
        </div>
    </form>

    <!-- Siatka kafelków (Cards) -->
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <span class="badge bg-secondary mb-2">@item.Category?.Name</span>
                        <h5 class="card-title">@item.Title</h5>
                        <h6 class="card-subtitle mb-2 text-muted">Autor: @item.Author?.FirstName @item.Author?.LastName</h6>
                        <p class="card-text">
                            <strong>Wydawca:</strong> @item.Publisher<br />
                            <strong>Rok wydania:</strong> @item.PublicationYear<br />
                            <strong>ISBN:</strong> @item.ISBN
                        </p>
                    </div>
                    <div class="card-footer bg-transparent border-top-0 d-flex justify-content-between">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Szczegóły</a>
                        @if (User.IsInRole("Administrator") || User.IsInRole("Bibliotekarz"))
                        {
                            <div>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Edytuj</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Usuń</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>