@model IEnumerable<Biblioteka.Models.Book>
@using Biblioteka.Constants

@{
    ViewData["Title"] = "Katalog książek";
    bool hasActiveAdvancedFilters = ViewBag.CurrentCategoryId != null ||
                                    ViewBag.CurrentAuthorId != null ||
                                    ViewBag.CurrentYearFrom != null ||
                                    ViewBag.CurrentYearTo != null;
}

<div class="container py-4">
    <!-- Nagłówek strony -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-primary-soft rounded-3 p-3 fs-4 d-none d-sm-flex">
                <i class="bi bi-book-half"></i>
            </div>
            <div>
                <h2 class="fw-bold mb-1">Katalog książek</h2>
                <p class="text-muted mb-0 small">Przeszukuj zbiory, filtruj po kategoriach i sprawdzaj dostępność egzemplarzy</p>
            </div>
        </div>

        @if (User.IsInRole(UserRoles.Admin) || User.IsInRole(UserRoles.Librarian))
        {
            <a asp-action="Create" class="btn btn-accent w-100 w-sm-auto">
                <i class="bi bi-plus-lg me-1"></i>Dodaj nową książkę
            </a>
        }
    </div>

    <!-- Panel filtrów dynamicznych -->
    <div class="card mb-4">
        <div class="card-body p-3 p-md-4">
            <form id="filtersForm" class="row g-3">
                <!-- Wyszukiwarka tekstowa (zawsze widoczna) -->
                <div class="col-12 col-md-8 col-lg-5">
                    <label for="searchString" class="form-label fw-semibold small text-muted mb-1">
                        Szukaj w katalogu
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted border-end-0">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="searchString" name="searchString" class="form-control border-start-0 ps-0"
                               placeholder="Tytuł, autor lub numer ISBN..." value="@ViewBag.CurrentSearch" autocomplete="off" />
                    </div>
                </div>

                <!-- Przyciski sterujące (mobile: rozwijanie filtrów + reset) -->
                <div class="col-12 col-md-4 col-lg-7 d-flex align-items-end justify-content-between justify-content-md-end gap-2">
                    <button class="btn btn-outline-primary d-md-none flex-grow-1" type="button"
                            data-bs-toggle="collapse" data-bs-target="#advancedFiltersCollapse"
                            aria-expanded="@(hasActiveAdvancedFilters ? "true" : "false")"
                            aria-controls="advancedFiltersCollapse">
                        <i class="bi bi-sliders me-1"></i>Filtry zaawansowane
                    </button>

                    <span id="loadingIndicator" class="text-primary small fw-semibold d-none me-auto ms-lg-3 align-self-center">
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        Aktualizowanie...
                    </span>

                    <button type="button" id="btnReset" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Wyczyść
                    </button>
                </div>

                <!-- Filtry szczegółowe (zwijane na mobile, zawsze widoczne od md wzwyż) -->
                <div class="col-12 collapse d-md-block @(hasActiveAdvancedFilters ? "show" : "")" id="advancedFiltersCollapse">
                    <div class="row g-3 pt-2 border-top mt-1">
                        <!-- Filtr Kategorii -->
                        <div class="col-12 col-sm-6 col-lg-4">
                            <label for="categoryId" class="form-label fw-semibold small text-muted mb-1">Kategoria</label>
                            <select id="categoryId" name="categoryId" class="form-select" asp-items="ViewBag.Categories">
                                <option value="">-- Wszystkie kategorie --</option>
                            </select>
                        </div>

                        <!-- Filtr Autora -->
                        <div class="col-12 col-sm-6 col-lg-4">
                            <label for="authorId" class="form-label fw-semibold small text-muted mb-1">Autor</label>
                            <select id="authorId" name="authorId" class="form-select" asp-items="ViewBag.Authors">
                                <option value="">-- Wszyscy autorzy --</option>
                            </select>
                        </div>

                        <!-- Widełki czasowe (Rok od - Rok do) -->
                        <div class="col-6 col-lg-2">
                            <label for="yearFrom" class="form-label fw-semibold small text-muted mb-1">Rok od</label>
                            <input type="number" id="yearFrom" name="yearFrom" class="form-control"
                                   placeholder="np. 1990" value="@ViewBag.CurrentYearFrom" />
                        </div>
                        <div class="col-6 col-lg-2">
                            <label for="yearTo" class="form-label fw-semibold small text-muted mb-1">Rok do</label>
                            <input type="number" id="yearTo" name="yearTo" class="form-control"
                                   placeholder="np. 2026" value="@ViewBag.CurrentYearTo" />
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Kontener na listę/siatkę książek podmienianą przez AJAX -->
    <div id="booksTableContainer" style="transition: opacity 0.18s ease;">
        <partial name="_BookListPartial" model="Model" />
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("searchString");
            const categorySelect = document.getElementById("categoryId");
            const authorSelect = document.getElementById("authorId");
            const yearFromInput = document.getElementById("yearFrom");
            const yearToInput = document.getElementById("yearTo");
            const btnReset = document.getElementById("btnReset");
            const container = document.getElementById("booksTableContainer");
            const loader = document.getElementById("loadingIndicator");

            let debounceTimer = null;

            function fetchFilteredBooks() {
                loader.classList.remove("d-none");
                container.style.opacity = "0.55";

                const params = new URLSearchParams({
                    searchString: searchInput.value,
                    categoryId: categorySelect.value,
                    authorId: authorSelect.value,
                    yearFrom: yearFromInput.value,
                    yearTo: yearToInput.value
                });

                const url = `@Url.Action("Index", "Books")?${params.toString()}`;

                fetch(url, {
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    }
                })
                .then(response => {
                    if (!response.ok) throw new Error("Błąd podczas pobierania danych");
                    return response.text();
                })
                .then(html => {
                    container.innerHTML = html;
                    window.history.replaceState({}, "", url);
                })
                .catch(err => {
                    console.error("Błąd filtrowania:", err);
                })
                .finally(() => {
                    loader.classList.add("d-none");
                    container.style.opacity = "1";
                });
            }

            function triggerDebouncedSearch() {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(fetchFilteredBooks, 300);
            }

            searchInput.addEventListener("input", triggerDebouncedSearch);
            yearFromInput.addEventListener("input", triggerDebouncedSearch);
            yearToInput.addEventListener("input", triggerDebouncedSearch);

            categorySelect.addEventListener("change", fetchFilteredBooks);
            authorSelect.addEventListener("change", fetchFilteredBooks);

            btnReset.addEventListener("click", function () {
                searchInput.value = "";
                categorySelect.value = "";
                authorSelect.value = "";
                yearFromInput.value = "";
                yearToInput.value = "";
                fetchFilteredBooks();
            });
        });
    </script>
}