@model Biblioteka.Models.Book

@{
    ViewData["Title"] = "Edycja książki";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Katalog książek</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Edycja pozycji</li>
                </ol>
            </nav>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-pencil-square me-2"></i>Edycja książki: @Model.Title
                    </h5>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()

                        <!-- Ukryty klucz główny -->
                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <!-- Tytuł -->
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold">Tytuł książki</label>
                            <input asp-for="Title" class="form-control" placeholder="Wprowadź tytuł..." />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <!-- Autor i Kategoria -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="AuthorId" class="form-label fw-bold">Autor</label>
                                <select asp-for="AuthorId" class="form-select" asp-items="ViewBag.AuthorId">
                                    <option value="">-- Wybierz autora --</option>
                                </select>
                                <span asp-validation-for="AuthorId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label fw-bold">Kategoria</label>
                                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                                    <option value="">-- Wybierz kategorię --</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- ISBN, Rok wydania, Wydawca -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label asp-for="ISBN" class="form-label fw-bold">Numer ISBN</label>
                                <input asp-for="ISBN" class="form-control" placeholder="np. 978-83-01-00000-0" />
                                <span asp-validation-for="ISBN" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="PublicationYear" class="form-label fw-bold">Rok wydania</label>
                                <input asp-for="PublicationYear" class="form-control" type="number" />
                                <span asp-validation-for="PublicationYear" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Publisher" class="form-label fw-bold">Wydawnictwo</label>
                                <input asp-for="Publisher" class="form-control" placeholder="Nazwa wydawnictwa" />
                                <span asp-validation-for="Publisher" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Opis -->
                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-bold">Opis / Streszczenie</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Krótki opis książki..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <hr class="my-4" />

                        <!-- Przyciski akcji -->
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Anuluj i wróć
                            </a>
                            <div>
                                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info me-2">
                                    <i class="bi bi-eye me-1"></i>Szczegóły
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-check-lg me-1"></i>Zapisz zmiany
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}