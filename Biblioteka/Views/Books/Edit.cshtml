@model Biblioteka.Models.Book

@{
    ViewData["Title"] = "Edycja książki";
    var currentSelectedIds = ViewBag.SelectedCategoryIds as int[]
                             ?? Model.Categories?.Select(c => c.Id).ToArray()
                             ?? Array.Empty<int>();
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Katalog książek</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Edycja pozycji</li>
                </ol>
            </nav>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-pencil-square me-2"></i>Edycja książki: @Model.Title
                    </h5>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()

                        <!-- Ukryty klucz główny -->
                        <input type="hidden" asp-for="Id" />

                        <!-- Podsumowanie błędów walidacji -->
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <!-- Tytuł -->
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold">Tytuł książki</label>
                            <input asp-for="Title" class="form-control" placeholder="Wprowadź tytuł..." />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <!-- Autor i Kategorie -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="AuthorId" class="form-label fw-bold">Autor</label>
                                <select asp-for="AuthorId" class="form-select" asp-items="ViewBag.AuthorId">
                                    <option value="">-- Wybierz autora --</option>
                                </select>
                                <span asp-validation-for="AuthorId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Kategorie</label>
                                <div class="border rounded p-3 bg-light" style="max-height: 180px; overflow-y: auto;">
                                    @if (ViewBag.CategoriesList != null)
                                    {
                                        foreach (var category in (IEnumerable<Biblioteka.Models.Category>)ViewBag.CategoriesList)
                                        {
                                            var isChecked = currentSelectedIds.Contains(category.Id);
                                            <div class="form-check">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       name="selectedCategoryIds"
                                                       value="@category.Id"
                                                       id="cat_@category.Id"
                                                @(isChecked ? "checked" : "") />
                                                <label class="form-check-label" for="cat_@category.Id">
                                                    @category.Name
                                                </label>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Brak dostępnych kategorii.</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- ISBN, Rok wydania, Wydawca -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label asp-for="ISBN" class="form-label fw-bold">Numer ISBN</label>
                                <input asp-for="ISBN" class="form-control" placeholder="np. 978-83-01-00000-0" />
                                <span asp-validation-for="ISBN" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="PublicationYear" class="form-label fw-bold">Rok wydania</label>
                                <input asp-for="PublicationYear" class="form-control" type="number" />
                                <span asp-validation-for="PublicationYear" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Publisher" class="form-label fw-bold">Wydawnictwo</label>
                                <input asp-for="Publisher" class="form-control" placeholder="Nazwa wydawnictwa" />
                                <span asp-validation-for="Publisher" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Adres URL okładki -->
                        <div class="mb-3">
                            <label asp-for="CoverImageUrl" class="form-label fw-bold">Adres URL okładki</label>
                            <input asp-for="CoverImageUrl" class="form-control" placeholder="https://example.com/okladka.jpg" />
                            <span asp-validation-for="CoverImageUrl" class="text-danger small"></span>
                        </div>

                        <!-- Opis -->
                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-bold">Opis / Streszczenie</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Krótki opis książki..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <hr class="my-4" />

                        <!-- Przyciski akcji -->
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Anuluj i wróć
                            </a>
                            <div>
                                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info me-2">
                                    <i class="bi bi-eye me-1"></i>Szczegóły
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-check-lg me-1"></i>Zapisz zmiany
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}