@model IEnumerable<Biblioteka.Models.Book>
@using Biblioteka.Constants
@using Biblioteka.Models

@{
    bool isStaff = User.Identity?.IsAuthenticated == true &&
                   (User.IsInRole(UserRoles.Admin) || User.IsInRole(UserRoles.Librarian));
    int count = Model.Count();
}

<!-- Pasek z liczbą wyników -->
<div class="d-flex justify-content-between align-items-center mb-3 px-1">
    <span class="text-muted small">
        Znaleziono pozycji: <strong class="text-dark">@count</strong>
    </span>
</div>

@if (!Model.Any())
{
    <div class="card border-0 p-5 text-center text-muted">
        <i class="bi bi-search fs-1 mb-2 text-primary opacity-50"></i>
        <h5 class="fw-bold text-dark">Brak wyników</h5>
        <p class="mb-0 small">Nie znaleziono książek spełniających podane kryteria wyszukiwania.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-3 g-md-4">
        @foreach (var book in Model)
        {
            var totalCopies = book.Copies?.Count ?? 0;
            var availableCopies = book.Copies?.Count(c => c.Status == BookStatus.Available) ?? 0;

            <div class="col">
                <div class="card card-hover h-100 d-flex flex-column">
                    <!-- Górna sekcja z okładką lub placeholderem -->
                    <a asp-action="Details" asp-route-id="@book.Id" class="text-decoration-none">
                        <div class="book-cover-placeholder">
                            <span class="book-cover-spine"></span>

                            <!-- Górny pasek z odznakami -->
                            <div class="d-flex justify-content-between align-items-start ps-2 gap-1 position-relative" style="z-index: 2;">
                                <span class="badge bg-white text-dark shadow-sm border">
                                    @book.PublicationYear r.
                                </span>

                                @if (totalCopies == 0)
                                {
                                    <span class="badge bg-secondary shadow-sm">Brak sztuk</span>
                                }
                                else if (availableCopies > 0)
                                {
                                    <span class="badge bg-success shadow-sm">Dostępna (@availableCopies/@totalCopies)</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark shadow-sm">Wypożyczona (0/@totalCopies)</span>
                                }
                            </div>

                            <!-- Środek: Okładka książki lub ikona zastępcza -->
                            <div class="flex-grow-1 d-flex align-items-center justify-content-center ps-2 my-1">
                                @if (!string.IsNullOrWhiteSpace(book.CoverImageUrl))
                                {
                                    <img src="@book.CoverImageUrl"
                                         alt="Okładka @book.Title"
                                         class="book-cover-img"
                                         loading="lazy"
                                         onerror="this.onerror=null; this.outerHTML='<i class=\'bi bi-book text-primary opacity-50 fs-1\'></i>';" />
                                }
                                else
                                {
                                    <i class="bi bi-book text-primary opacity-50 fs-1"></i>
                                }
                            </div>
                        </div>
                    </a>

                    <!-- Treść karty -->
                    <div class="card-body d-flex flex-column flex-grow-1 p-3">
                        <h5 class="card-title fw-bold mb-1 fs-6">
                            <a asp-action="Details" asp-route-id="@book.Id" class="text-decoration-none text-dark">
                                @book.Title
                            </a>
                        </h5>

                        <p class="text-muted small mb-2">
                            <i class="bi bi-person me-1"></i>@(book.Author != null ? $"{book.Author.FirstName} {book.Author.LastName}" : "Autor nieznany")
                        </p>

                        <!-- Kategorie -->
                        <div class="d-flex flex-wrap gap-1 mb-3">
                            @if (book.Categories != null && book.Categories.Any())
                            {
                                @foreach (var category in book.Categories)
                                {
                                    <span class="badge bg-primary-soft fw-medium">@category.Name</span>
                                }
                            }
                            else if (book.Category != null)
                            {
                                <span class="badge bg-primary-soft fw-medium">@book.Category.Name</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border fw-normal">Bez kategorii</span>
                            }
                        </div>

                        <!-- Stopka karty z przyciskami akcji -->
                        <div class="mt-auto pt-2 border-top d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-outline-primary flex-grow-1">
                                <i class="bi bi-eye me-1"></i>Szczegóły
                            </a>

                            @if (isStaff)
                            {
                                <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-outline-secondary" title="Edytuj książkę">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@book.Id" class="btn btn-sm btn-outline-danger" title="Usuń książkę">
                                    <i class="bi bi-trash"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}