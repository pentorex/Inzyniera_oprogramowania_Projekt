@model IEnumerable<Biblioteka.Models.Borrowing>

@{
    ViewData["Title"] = "Moje wypożyczenia";
    var today = DateTime.UtcNow.Date;
    var activeBorrowings = Model.Where(b => b.ReturnDate == null).ToList();
    var returnedBorrowings = Model.Where(b => b.ReturnDate != null).ToList();
    var overdueCount = activeBorrowings.Count(b => b.DueDate.Date < today);
    var totalCurrentFine = activeBorrowings.Sum(b => b.CalculateFine());
}

<div class="container py-4">
    <!-- Nagłówek strony -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-primary-soft rounded-3 p-3 fs-4 d-none d-sm-flex">
                <i class="bi bi-bookmark-heart"></i>
            </div>
            <div>
                <h2 class="fw-bold mb-1">Moje wypożyczenia</h2>
                <p class="text-muted mb-0 small">Aktualnie posiadane książki, terminy zwrotów oraz historia konta</p>
            </div>
        </div>
        <a asp-controller="Books" asp-action="Index" class="btn btn-accent w-100 w-sm-auto">
            <i class="bi bi-search me-1"></i>Przeglądaj katalog
        </a>
    </div>

    <!-- Podsumowanie liczników (2x2 na mobile, 4x1 na desktop) -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary-soft rounded-3 p-2 p-sm-3 fs-4">
                        <i class="bi bi-book"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-primary lh-1">@activeBorrowings.Count</div>
                        <div class="small text-muted mt-1">Wypożyczone</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-danger-subtle text-danger rounded-3 p-2 p-sm-3 fs-4">
                        <i class="bi bi-exclamation-circle"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-danger lh-1">@overdueCount</div>
                        <div class="small text-muted mt-1">Po terminie</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-accent-soft rounded-3 p-2 p-sm-3 fs-4">
                        <i class="bi bi-cash-coin"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold @(totalCurrentFine > 0 ? "text-danger" : "text-dark") lh-1">
                            @totalCurrentFine.ToString("0.00") zł
                        </div>
                        <div class="small text-muted mt-1">Naliczone opłaty</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-success-subtle text-success rounded-3 p-2 p-sm-3 fs-4">
                        <i class="bi bi-check2-all"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-success lh-1">@returnedBorrowings.Count</div>
                        <div class="small text-muted mt-1">Zwrócone</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sekcja 1: Aktywne wypożyczenia -->
    <div class="card border-0 mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-bold fs-6">
                <i class="bi bi-book me-2 text-primary"></i>Aktywne wypożyczenia (@activeBorrowings.Count)
            </h5>
        </div>

        @if (!activeBorrowings.Any())
        {
            <div class="card-body p-5 text-center text-muted">
                <i class="bi bi-journal-check fs-1 d-block mb-2 text-primary opacity-50"></i>
                <p class="mb-2 fw-semibold text-dark">Brak aktywnych wypożyczeń</p>
                <p class="small mb-0">Nie masz obecnie żadnych wypożyczonych książek na swoim koncie.</p>
            </div>
        }
        else
        {
            <!-- Widok kart na urządzenia mobilne (< md) -->
            <div class="card-body p-3 d-md-none">
                <div class="d-flex flex-column gap-3">
                    @foreach (var item in activeBorrowings)
                    {
                        var isOverdue = item.DueDate.Date < today;
                        var daysLeft = (item.DueDate.Date - today).Days;
                        var isDueSoon = !isOverdue && daysLeft <= 3;
                        var currentFine = item.CalculateFine();
                        var book = item.BookCopy?.Book;
                        var borderClass = isOverdue ? "border-danger" : (isDueSoon ? "border-warning" : "border-primary");

                        <div class="border rounded-3 p-3 border-start border-4 @borderClass bg-white shadow-sm">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <div>
                                    @if (book != null)
                                    {
                                        <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id"
                                           class="fw-bold text-decoration-none text-dark d-block">
                                            @book.Title
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="fw-bold text-muted">Nieznany tytuł</span>
                                    }
                                    <div class="small text-muted">
                                        @(book?.Author != null ? $"{book.Author.FirstName} {book.Author.LastName}" : "Autor nieznany")
                                    </div>
                                </div>
                                <code class="small bg-primary-soft text-primary px-2 py-1 rounded">
                                    @(item.BookCopy?.InventoryNumber ?? $"#{item.BookCopyId}")
                                </code>
                            </div>

                            <div class="row g-2 small py-2 border-top border-bottom my-2">
                                <div class="col-6">
                                    <span class="text-muted d-block">Wypożyczono:</span>
                                    <span class="fw-semibold">@item.BorrowDate.ToString("dd.MM.yyyy")</span>
                                </div>
                                <div class="col-6">
                                    <span class="text-muted d-block">Termin zwrotu:</span>
                                    <span class="fw-bold @(isOverdue ? "text-danger" : "text-dark")">
                                        @item.DueDate.ToString("dd.MM.yyyy")
                                    </span>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center pt-1">
                                <div>
                                    @if (isOverdue)
                                    {
                                        var daysLate = (today - item.DueDate.Date).Days;
                                        <span class="badge bg-danger">
                                            <i class="bi bi-exclamation-circle me-1"></i>Po terminie (@daysLate dni)
                                        </span>
                                    }
                                    else if (isDueSoon)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-clock-history me-1"></i>@(daysLeft == 0 ? "Termin dzisiaj" : $"Zostało {daysLeft} dni")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary-soft">
                                            <i class="bi bi-book-half me-1"></i>W trakcie czytania
                                        </span>
                                    }
                                </div>

                                @if (currentFine > 0)
                                {
                                    <span class="fw-bold text-danger small">Kara: @currentFine.ToString("0.00") zł</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Widok tabeli na tablety i komputery (>= md) -->
            <div class="card-body p-0 d-none d-md-block">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Książka</th>
                                <th>Nr inw.</th>
                                <th>Wypożyczono</th>
                                <th>Termin zwrotu</th>
                                <th>Naliczone opłaty</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in activeBorrowings)
                            {
                                var isOverdue = item.DueDate.Date < today;
                                var daysLeft = (item.DueDate.Date - today).Days;
                                var isDueSoon = !isOverdue && daysLeft <= 3;
                                var currentFine = item.CalculateFine();
                                var book = item.BookCopy?.Book;

                                <tr class="@(isOverdue ? "table-danger" : "")">
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            @if (!string.IsNullOrWhiteSpace(book?.CoverImageUrl))
                                            {
                                                <img src="@book.CoverImageUrl" alt="" class="rounded border"
                                                     style="width: 34px; height: 48px; object-fit: cover;"
                                                     onerror="this.style.display='none'" />
                                            }
                                            else
                                            {
                                                <div class="bg-primary-soft rounded d-flex align-items-center justify-content-center flex-shrink-0"
                                                     style="width: 34px; height: 48px;">
                                                    <i class="bi bi-book"></i>
                                                </div>
                                            }
                                            <div>
                                                @if (book != null)
                                                {
                                                    <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id"
                                                       class="fw-bold text-decoration-none text-dark d-block">
                                                        @book.Title
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="fw-bold text-muted">Nieznany tytuł</span>
                                                }
                                                <span class="small text-muted">
                                                    @(book?.Author != null ? $"{book.Author.FirstName} {book.Author.LastName}" : "—")
                                                </span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <code class="fw-semibold text-primary bg-primary-soft px-2 py-1 rounded">
                                            @(item.BookCopy?.InventoryNumber ?? $"#{item.BookCopyId}")
                                        </code>
                                    </td>
                                    <td>@item.BorrowDate.ToString("dd.MM.yyyy")</td>
                                    <td class="fw-semibold @(isOverdue ? "text-danger" : "")">
                                        @item.DueDate.ToString("dd.MM.yyyy")
                                    </td>
                                    <td class="@(currentFine > 0 ? "text-danger fw-bold" : "text-muted")">
                                        @currentFine.ToString("0.00") zł
                                    </td>
                                    <td>
                                        @if (isOverdue)
                                        {
                                            var daysLate = (today - item.DueDate.Date).Days;
                                            <span class="badge bg-danger">
                                                <i class="bi bi-exclamation-circle me-1"></i>Po terminie (@daysLate dni)
                                            </span>
                                        }
                                        else if (isDueSoon)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-clock-history me-1"></i>@(daysLeft == 0 ? "Termin dzisiaj" : $"Zostało {daysLeft} dni")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary-soft">
                                                <i class="bi bi-book-half me-1"></i>W trakcie czytania
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <!-- Sekcja 2: Historia zwrotów -->
    <div class="card border-0">
        <div class="card-header bg-white py-3">
            <h5 class="card-title mb-0 fw-bold fs-6 text-secondary">
                <i class="bi bi-clock-history me-2"></i>Historia zwrotów (@returnedBorrowings.Count)
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Tytuł książki</th>
                            <th class="d-none d-sm-table-cell">Autor</th>
                            <th>Nr inw.</th>
                            <th class="d-none d-md-table-cell">Wypożyczono</th>
                            <th>Data zwrotu</th>
                            <th>Opłata</th>
                            <th class="text-end">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!returnedBorrowings.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted small">
                                    Brak historii wcześniejszych wypożyczeń.
                                </td>
                            </tr>
                        }
                        @foreach (var item in returnedBorrowings)
                        {
                            var book = item.BookCopy?.Book;
                            <tr>
                                <td>
                                    @if (book != null)
                                    {
                                        <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id"
                                           class="fw-semibold text-decoration-none text-dark">
                                            @book.Title
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Nieznany tytuł</span>
                                    }
                                    <div class="small text-muted d-sm-none">
                                        @(book?.Author != null ? $"{book.Author.FirstName} {book.Author.LastName}" : "—")
                                    </div>
                                </td>
                                <td class="d-none d-sm-table-cell text-muted">
                                    @(book?.Author != null ? $"{book.Author.FirstName} {book.Author.LastName}" : "—")
                                </td>
                                <td>
                                    <code class="small text-muted">@(item.BookCopy?.InventoryNumber ?? $"#{item.BookCopyId}")</code>
                                </td>
                                <td class="d-none d-md-table-cell text-muted">@item.BorrowDate.ToString("dd.MM.yyyy")</td>
                                <td>@item.ReturnDate?.ToString("dd.MM.yyyy")</td>
                                <td class="@(item.FineAmount > 0 ? "text-danger fw-semibold" : "text-muted")">
                                    @item.FineAmount.ToString("0.00") zł
                                </td>
                                <td class="text-end">
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-check-circle me-1"></i>Zwrócona
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>