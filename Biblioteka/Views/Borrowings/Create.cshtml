@model Biblioteka.Models.Borrowing

@{
    ViewData["Title"] = "Nowe wypożyczenie";
}

<div class="container py-4">
    <!-- Nagłówek strony -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-primary-soft rounded-3 p-3 fs-4 d-none d-sm-flex">
                <i class="bi bi-journal-plus"></i>
            </div>
            <div>
                <h2 class="fw-bold mb-1">Nowe wypożyczenie</h2>
                <p class="text-muted mb-0 small">Wyszukaj dostępne egzemplarze i przypisz je do konta czytelnika</p>
            </div>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary w-100 w-sm-auto">
            <i class="bi bi-arrow-left me-1"></i>Powrót do listy
        </a>
    </div>

    <form asp-action="Create" method="post" id="borrowingForm">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 mb-4"></div>

        <!-- KROK 1: Wyszukiwarka i wybór egzemplarzy -->
        <div class="card border-0 mb-4">
            <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary rounded-pill px-2 py-1">1</span>
                    <h5 class="fw-bold mb-0 fs-6">Wybierz egzemplarze do wypożyczenia</h5>
                </div>

                <span class="badge bg-primary-soft px-3 py-2">
                    <i class="bi bi-check2-square me-1"></i>Wybrano: <strong id="selectedCountBadge">0</strong> szt.
                </span>
            </div>

            <div class="card-body p-3 p-md-4 border-bottom bg-light bg-opacity-50">
                <div id="filtersForm" class="row g-3">
                    <!-- Wyszukiwarka tekstowa -->
                    <div class="col-12 col-lg-5">
                        <label for="searchString" class="form-label fw-semibold small text-muted mb-1">
                            Szukaj egzemplarza
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted border-end-0">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" id="searchString" name="searchString" class="form-control border-start-0 ps-0"
                                   placeholder="Tytuł, autor, ISBN lub nr inwentarzowy..." value="@ViewBag.CurrentSearch" autocomplete="off" />
                        </div>
                    </div>

                    <!-- Filtr Kategorii -->
                    <div class="col-12 col-sm-6 col-lg-3">
                        <label for="categoryId" class="form-label fw-semibold small text-muted mb-1">Kategoria</label>
                        <select id="categoryId" name="categoryId" class="form-select" asp-items="ViewBag.Categories">
                            <option value="">-- Wszystkie kategorie --</option>
                        </select>
                    </div>

                    <!-- Filtr Autora -->
                    <div class="col-12 col-sm-6 col-lg-3">
                        <label for="authorId" class="form-label fw-semibold small text-muted mb-1">Autor</label>
                        <select id="authorId" name="authorId" class="form-select" asp-items="ViewBag.AuthorId">
                            <option value="">-- Wszyscy autorzy --</option>
                        </select>
                    </div>

                    <!-- Przycisk resetu -->
                    <div class="col-12 col-lg-1 d-flex align-items-end">
                        <button type="button" id="btnReset" class="btn btn-outline-secondary w-100" title="Wyczyść filtry">
                            <i class="bi bi-arrow-counterclockwise"></i>
                            <span class="d-lg-none ms-1">Wyczyść filtry</span>
                        </button>
                    </div>

                    <div class="col-12">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <span class="text-muted small">
                                <i class="bi bi-info-circle me-1 text-primary"></i>Zaznacz pola wyboru przy wybranych egzemplarzach (możesz wybrać kilka pozycji naraz).
                            </span>
                            <span id="loadingIndicator" class="text-primary small fw-semibold d-none">
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                Wyszukiwanie...
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Kontener na tabelę/listę egzemplarzy podmienianą przez AJAX -->
            <div id="bookCopiesTableContainer" style="transition: opacity 0.18s ease;">
                @await Html.PartialAsync("_BookCopyListPartial", ViewData["AvailableCopies"] ?? new List<Biblioteka.Models.BookCopy>())
            </div>
        </div>
        <span asp-validation-for="BookCopyId" class="text-danger small d-block mb-3"></span>

        <!-- KROK 2: Dane czytelnika i termin zwrotu -->
        <div class="card border-0 mb-4">
            <div class="card-header bg-white py-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary rounded-pill px-2 py-1">2</span>
                    <h5 class="fw-bold mb-0 fs-6">Dane czytelnika i termin zwrotu</h5>
                </div>
            </div>
            <div class="card-body p-3 p-md-4">
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="UserId" class="form-label fw-semibold small text-muted mb-1">Czytelnik</label>
                        <select asp-for="UserId" class="form-select" asp-items="ViewBag.UserId">
                            <option value="">-- Wybierz czytelnika z listy --</option>
                        </select>
                        <span asp-validation-for="UserId" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="DueDate" class="form-label fw-semibold small text-muted mb-1">Termin zwrotu</label>
                        <input asp-for="DueDate" class="form-control" type="date" />
                        <span asp-validation-for="DueDate" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Przyciski formularza -->
        <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary px-4 order-2 order-sm-1">
                Anuluj
            </a>
            <button type="submit" class="btn btn-accent px-4 py-2 order-1 order-sm-2">
                <i class="bi bi-check2-circle me-2"></i>Zatwierdź wypożyczenie
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("searchString");
            const categorySelect = document.getElementById("categoryId");
            const authorSelect = document.getElementById("authorId");
            const btnReset = document.getElementById("btnReset");
            const container = document.getElementById("bookCopiesTableContainer");
            const loader = document.getElementById("loadingIndicator");
            const form = document.getElementById("borrowingForm");
            const selectedCountBadge = document.getElementById("selectedCountBadge");

            // Główny zbiór trzymający ID zaznaczonych elementów w pamięci przeglądarki
            const selectedCopyIds = new Set();
            let debounceTimer = null;

            function updateSelectedBadge() {
                if (selectedCountBadge) {
                    selectedCountBadge.textContent = selectedCopyIds.size;
                }
            }

            // Przywraca zaznaczenia checkboxów po podmianie HTML przez AJAX
            function restoreSelections() {
                const checkboxes = container.querySelectorAll(".copy-checkbox");
                checkboxes.forEach(checkbox => {
                    if (selectedCopyIds.has(checkbox.value)) {
                        checkbox.checked = true;
                    }
                });
                updateSelectedBadge();
            }

            // Globalna nasłuchiwarka zmian checkboxów
            document.addEventListener("change", function (event) {
                if (event.target.classList.contains("copy-checkbox")) {
                    const id = event.target.value;
                    if (event.target.checked) {
                        selectedCopyIds.add(id);
                    } else {
                        selectedCopyIds.delete(id);
                    }
                    updateSelectedBadge();
                }
            });

            function fetchFilteredCopies() {
                loader.classList.remove("d-none");
                container.style.opacity = "0.55";

                const params = new URLSearchParams({
                    searchString: searchInput.value,
                    categoryId: categorySelect.value,
                    authorId: authorSelect.value
                });

                fetch(`@Url.Action("Create", "Borrowings")?${params.toString()}`, {
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    }
                })
                .then(response => {
                    if (!response.ok) throw new Error("Błąd sieci");
                    return response.text();
                })
                .then(html => {
                    container.innerHTML = html;
                    restoreSelections();
                })
                .catch(err => console.error("Błąd filtrowania:", err))
                .finally(() => {
                    loader.classList.add("d-none");
                    container.style.opacity = "1";
                });
            }

            function triggerDebouncedSearch() {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(fetchFilteredCopies, 300);
            }

            searchInput.addEventListener("input", triggerDebouncedSearch);
            categorySelect.addEventListener("change", fetchFilteredCopies);
            authorSelect.addEventListener("change", fetchFilteredCopies);

            btnReset.addEventListener("click", function () {
                searchInput.value = "";
                categorySelect.value = "";
                authorSelect.value = "";
                fetchFilteredCopies();
            });

            // Generuje ukryte inputy dla wszystkich zaznaczonych pozycji przed wysłaniem
            form.addEventListener("submit", function () {
                document.querySelectorAll(".hidden-selected-copy").forEach(el => el.remove());

                selectedCopyIds.forEach(id => {
                    const hiddenInput = document.createElement("input");
                    hiddenInput.type = "hidden";
                    hiddenInput.name = "selectedBookCopyIds";
                    hiddenInput.value = id;
                    hiddenInput.className = "hidden-selected-copy";
                    form.appendChild(hiddenInput);
                });
            });
        });
    </script>
}