@model IEnumerable<Biblioteka.Models.Borrowing>
@using Biblioteka.Constants

@{
    ViewData["Title"] = "Zarządzanie wypożyczeniami";
    string currentSearch = ViewBag.CurrentSearch as string ?? "";
    string currentStatus = ViewBag.CurrentStatus as string ?? "";
}

<div class="container py-4">
    <!-- Nagłówek strony -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-primary-soft rounded-3 p-3 fs-4 d-none d-sm-flex">
                <i class="bi bi-journal-text"></i>
            </div>
            <div>
                <h2 class="fw-bold mb-1">Zarządzanie wypożyczeniami</h2>
                <p class="text-muted mb-0 small">Przeszukuj aktywne wypożyczenia, rejestruj zwroty i kontroluj terminy</p>
            </div>
        </div>

        <a asp-action="Create" class="btn btn-accent w-100 w-sm-auto">
            <i class="bi bi-plus-lg me-1"></i>Nowe wypożyczenie
        </a>
    </div>

    <!-- Panel wyszukiwania i filtrów -->
    <div class="card border-0 mb-4">
        <div class="card-body p-3 p-md-4">
            <div id="filterForm" class="row g-3">
                <div class="col-12 col-md-6 col-lg-5">
                    <label for="searchString" class="form-label fw-semibold small text-muted mb-1">
                        Szukaj wypożyczenia
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted border-end-0">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="searchString" name="searchString" class="form-control border-start-0 ps-0"
                               placeholder="Tytuł książki, nr inwentarzowy lub e-mail..." value="@currentSearch" autocomplete="off" />
                    </div>
                </div>

                <div class="col-12 col-sm-7 col-md-4 col-lg-4">
                    <label for="statusFilter" class="form-label fw-semibold small text-muted mb-1">
                        Status wypożyczenia
                    </label>
                    <select id="statusFilter" name="statusFilter" class="form-select">
                        <option value="">-- Wszystkie statusy --</option>
                        <option value="active" selected="@(currentStatus == "active")">Aktywne wypożyczenia</option>
                        <option value="overdue" selected="@(currentStatus == "overdue")">Przeterminowane</option>
                        <option value="returned" selected="@(currentStatus == "returned")">Zwrócone</option>
                    </select>
                </div>

                <div class="col-12 col-sm-5 col-md-2 col-lg-3 d-flex align-items-end justify-content-between justify-content-md-end gap-2">
                    <span id="loadingIndicator" class="text-primary small fw-semibold d-none me-auto align-self-center">
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        Szukanie...
                    </span>

                    <button type="button" id="btnReset" class="btn btn-outline-secondary w-100 w-lg-auto">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Wyczyść
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Kontener na listę wypożyczeń podmienianą przez AJAX -->
    <div id="borrowingsTableContainer" style="transition: opacity 0.18s ease;">
        @await Html.PartialAsync("_BorrowingListPartial", Model)
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("searchString");
            const statusSelect = document.getElementById("statusFilter");
            const btnReset = document.getElementById("btnReset");
            const container = document.getElementById("borrowingsTableContainer");
            const loader = document.getElementById("loadingIndicator");

            let debounceTimer = null;

            function fetchFilteredBorrowings() {
                loader.classList.remove("d-none");
                container.style.opacity = "0.55";

                const params = new URLSearchParams({
                    searchString: searchInput.value,
                    statusFilter: statusSelect.value
                });

                const url = `@Url.Action("Index", "Borrowings")?${params.toString()}`;

                fetch(url, {
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    }
                })
                .then(response => {
                    if (!response.ok) throw new Error("Błąd podczas pobierania danych");
                    return response.text();
                })
                .then(html => {
                    container.innerHTML = html;
                    window.history.replaceState({}, "", url);
                })
                .catch(err => {
                    console.error("Błąd filtrowania wypożyczeń:", err);
                })
                .finally(() => {
                    loader.classList.add("d-none");
                    container.style.opacity = "1";
                });
            }

            function triggerDebouncedSearch() {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(fetchFilteredBorrowings, 300);
            }

            searchInput.addEventListener("input", triggerDebouncedSearch);
            statusSelect.addEventListener("change", fetchFilteredBorrowings);

            btnReset.addEventListener("click", function () {
                searchInput.value = "";
                statusSelect.value = "";
                fetchFilteredBorrowings();
            });
        });
    </script>
}