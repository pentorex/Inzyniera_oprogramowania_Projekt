@model IEnumerable<Biblioteka.Models.BookCopy>

<div class="table-responsive" style="max-height: 350px; overflow-y: auto;">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light sticky-top">
            <tr>
                <th style="width: 60px;">Wybierz</th>
                <th>Tytuł i Autor</th>
                <th>ISBN</th>
                <th>Nr inwentarzowy</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center py-4 text-muted">
                        Nie znaleziono dostępnych egzemplarzy.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var copy in Model)
                {
                    <tr>
                        <td>
                            <div class="form-check">
                                <input class="form-check-input copy-checkbox" type="checkbox"
                                       value="@copy.Id" id="copy_@copy.Id" />
                            </div>
                        </td>
                        <td>
                            <label class="form-check-label fw-bold d-block" for="copy_@copy.Id" style="cursor: pointer;">
                                @copy.Book?.Title
                            </label>
                            <span class="text-muted small">
                                Autor: @(copy.Book?.Author != null ? $"{copy.Book.Author.FirstName} {copy.Book.Author.LastName}" : "Brak")
                            </span>
                        </td>
                        <td><code>@copy.Book?.ISBN</code></td>
                        <td><span class="badge bg-secondary">@copy.InventoryNumber</span></td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>