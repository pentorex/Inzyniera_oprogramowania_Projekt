@model IEnumerable<Biblioteka.Models.Borrowing>

@{
    int count = Model.Count();
}

<!-- Pasek z liczbą wyników -->
<div class="d-flex justify-content-between align-items-center mb-3 px-1">
    <span class="text-muted small">
        Znaleziono wypożyczeń: <strong class="text-dark">@count</strong>
    </span>
</div>

@if (!Model.Any())
{
    <div class="card border-0 p-5 text-center text-muted">
        <i class="bi bi-inbox fs-1 d-block mb-2 text-primary opacity-50"></i>
        <h5 class="fw-bold text-dark">Brak wyników</h5>
        <p class="mb-0 small">Nie znaleziono wypożyczeń spełniających podane kryteria.</p>
    </div>
}
else
{
    <!-- Widok kart na urządzenia mobilne i małe tablety (< lg) -->
    <div class="d-lg-none d-flex flex-column gap-3">
        @foreach (var item in Model)
        {
            bool isReturned = item.ReturnDate.HasValue;
            bool isOverdue = !isReturned && DateTime.UtcNow > item.DueDate;
            decimal fineValue = item.CalculateFine();
            bool hasFine = item.FineAmount > 0 || isOverdue;
            var book = item.BookCopy?.Book;
            var borderClass = isOverdue ? "border-danger" : (isReturned ? "border-secondary" : "border-primary");

            <div class="card border-0 border-start border-4 @borderClass">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <div>
                            @if (book != null)
                            {
                                <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id"
                                   class="fw-bold text-decoration-none text-dark d-block">
                                    @book.Title
                                </a>
                            }
                            else
                            {
                                <span class="fw-bold text-dark">Nieznany tytuł</span>
                            }
                            <div class="small text-muted mt-1">
                                <i class="bi bi-person me-1"></i>@(item.User?.Email ?? "Brak danych czytelnika")
                            </div>
                        </div>

                        <code class="small fw-semibold text-primary bg-primary-soft px-2 py-1 rounded flex-shrink-0">
                            @(item.BookCopy?.InventoryNumber ?? $"#{item.BookCopyId}")
                        </code>
                    </div>

                    <div class="row g-2 small py-2 border-top border-bottom my-2">
                        <div class="col-4">
                            <span class="text-muted d-block">Wypożyczono</span>
                            <span class="fw-semibold">@item.BorrowDate.ToLocalTime().ToShortDateString()</span>
                        </div>
                        <div class="col-4">
                            <span class="text-muted d-block">Termin</span>
                            <span class="fw-bold @(isOverdue ? "text-danger" : "text-dark")">
                                @item.DueDate.ToLocalTime().ToShortDateString()
                            </span>
                        </div>
                        <div class="col-4">
                            <span class="text-muted d-block">Kara</span>
                            @if (hasFine && fineValue > 0)
                            {
                                <span class="fw-bold text-danger">@fineValue.ToString("0.00") zł</span>
                            }
                            else
                            {
                                <span class="text-success fw-semibold">0.00 zł</span>
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center gap-2 pt-1">
                        <div>
                            @if (isReturned)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    <i class="bi bi-check-circle me-1"></i>Zwrócono @item.ReturnDate!.Value.ToLocalTime().ToShortDateString()
                                </span>
                            }
                            else if (isOverdue)
                            {
                                <span class="badge bg-danger">
                                    <i class="bi bi-exclamation-circle me-1"></i>Przeterminowana
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-primary-soft">
                                    <i class="bi bi-clock me-1"></i>W trakcie
                                </span>
                            }
                        </div>

                        @if (!isReturned)
                        {
                            <form asp-action="ReturnBook" asp-route-id="@item.Id" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-success"
                                        onclick="return confirm('Czy na pewno chcesz przyjąć zwrot tej książki?');">
                                    <i class="bi bi-box-arrow-in-down-left me-1"></i>Przyjmij zwrot
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Widok tabeli na większe ekrany (>= lg) -->
    <div class="card border-0 d-none d-lg-block">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Tytuł książki</th>
                        <th>Nr inw.</th>
                        <th>Czytelnik</th>
                        <th>Wypożyczono</th>
                        <th>Termin zwrotu</th>
                        <th>Status / Data zwrotu</th>
                        <th>Kara</th>
                        <th class="text-end">Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        bool isReturned = item.ReturnDate.HasValue;
                        bool isOverdue = !isReturned && DateTime.UtcNow > item.DueDate;
                        decimal fineValue = item.CalculateFine();
                        bool hasFine = item.FineAmount > 0 || isOverdue;
                        var book = item.BookCopy?.Book;

                        <tr class="@(isOverdue ? "table-danger" : "")">
                            <td>
                                @if (book != null)
                                {
                                    <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id"
                                       class="fw-bold text-decoration-none text-dark">
                                        @book.Title
                                    </a>
                                }
                                else
                                {
                                    <strong class="text-dark">Nieznany tytuł</strong>
                                }
                            </td>
                            <td>
                                <code class="fw-semibold text-primary bg-primary-soft px-2 py-1 rounded">
                                    @(item.BookCopy?.InventoryNumber ?? $"#{item.BookCopyId}")
                                </code>
                            </td>
                            <td class="text-muted small">@(item.User?.Email ?? "—")</td>
                            <td>@item.BorrowDate.ToLocalTime().ToShortDateString()</td>
                            <td>
                                <span class="fw-semibold @(isOverdue ? "text-danger" : "")">
                                    @item.DueDate.ToLocalTime().ToShortDateString()
                                </span>
                                @if (isOverdue)
                                {
                                    <span class="badge bg-danger ms-1">Przeterminowana</span>
                                }
                            </td>
                            <td>
                                @if (isReturned)
                                {
                                    <span class="text-muted small">
                                        Zwrócono: <strong class="text-dark">@item.ReturnDate!.Value.ToLocalTime().ToShortDateString()</strong>
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-primary-soft">W trakcie wypożyczenia</span>
                                }
                            </td>
                            <td>
                                @if (hasFine && fineValue > 0)
                                {
                                    <span class="text-danger fw-bold">@fineValue.ToString("0.00") zł</span>
                                }
                                else
                                {
                                    <span class="text-success small fw-semibold">0.00 zł</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (!isReturned)
                                {
                                    <form asp-action="ReturnBook" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-success"
                                                onclick="return confirm('Czy na pewno chcesz przyjąć zwrot tej książki?');">
                                            <i class="bi bi-box-arrow-in-down-left me-1"></i>Zwróć
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-check-circle me-1"></i>Zwrócono
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}