@model IEnumerable<Biblioteka.Models.Borrowing>

@{
    ViewData["Title"] = "Raport zaległości i naliczania kar";
    int totalOverdueCount = ViewBag.TotalOverdueCount ?? 0;
    decimal totalAccruedFines = ViewBag.TotalAccruedFines ?? 0m;
    decimal totalHistoricalFines = ViewBag.TotalHistoricalFines ?? 0m;
    int debtorsCount = ViewBag.DebtorsCount ?? 0;
    decimal dailyRate = ViewBag.DailyFineRate ?? 0.50m;
}

<style>
    @@media print {
        .d-print-none, header, footer, .btn, form {
            display: none !important;
        }

        .card {
            border: 1px solid #dee2e6 !important;
            box-shadow: none !important;
        }

        body {
            background-color: #fff !important;
        }
    }
</style>

<div class="container py-4">
    <!-- Nagłówek raportu -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-danger-subtle text-danger rounded-3 p-3 fs-4 d-none d-sm-flex">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <div>
                <h2 class="fw-bold mb-1">Raport zaległości i naliczania kar</h2>
                <p class="text-muted mb-0 small">
                    Wygenerowano: <strong class="text-dark">@DateTime.Now.ToString("dd.MM.yyyy HH:mm")</strong>
                    <span class="mx-1">&bull;</span>
                    Stawka kary: <strong class="text-danger">@dailyRate.ToString("0.00") zł / dzień</strong>
                </p>
            </div>
        </div>

        <div class="d-flex flex-column flex-sm-row gap-2 d-print-none">
            <button type="button" onclick="window.print()" class="btn btn-accent">
                <i class="bi bi-printer me-1"></i>Drukuj raport
            </button>
            <a asp-action="Index" class="btn btn-outline-primary">
                <i class="bi bi-arrow-left me-1"></i>Wszystkie wypożyczenia
            </a>
        </div>
    </div>

    <!-- Karty statystyk (2x2 na mobile, 4x1 na desktop) -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-danger-subtle text-danger rounded-3 p-2 p-sm-3 fs-4 flex-shrink-0">
                        <i class="bi bi-journal-x"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-danger lh-1">@totalOverdueCount</div>
                        <div class="small fw-semibold text-dark mt-1">Przetrzymane</div>
                        <div class="text-muted" style="font-size: 0.75rem;">aktywne zaległości</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-accent-soft rounded-3 p-2 p-sm-3 fs-4 flex-shrink-0">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-accent lh-1">@totalAccruedFines.ToString("0.00") zł</div>
                        <div class="small fw-semibold text-dark mt-1">Kary bieżące</div>
                        <div class="text-muted" style="font-size: 0.75rem;">do rozliczenia</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-success-subtle text-success rounded-3 p-2 p-sm-3 fs-4 flex-shrink-0">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-success lh-1">@totalHistoricalFines.ToString("0.00") zł</div>
                        <div class="small fw-semibold text-dark mt-1">Kary historyczne</div>
                        <div class="text-muted" style="font-size: 0.75rem;">rozliczone zwroty</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary-soft rounded-3 p-2 p-sm-3 fs-4 flex-shrink-0">
                        <i class="bi bi-people"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-primary lh-1">@debtorsCount</div>
                        <div class="small fw-semibold text-dark mt-1">Dłużnicy</div>
                        <div class="text-muted" style="font-size: 0.75rem;">konta z zaległością</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Pasek filtrowania -->
    <div class="card border-0 mb-4 d-print-none">
        <div class="card-body p-3 p-md-4">
            <form id="overdueFilterForm" method="get" asp-action="OverdueReport" class="row g-3 align-items-end">
                <div class="col-12 col-md-6 col-lg-4">
                    <label for="searchString" class="form-label fw-semibold small text-muted mb-1">
                        Czytelnik, książka lub nr inw.
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted border-end-0">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="searchString" name="searchString" value="@ViewBag.CurrentSearch"
                               class="form-control border-start-0 ps-0" placeholder="Szukaj w raporcie..." autocomplete="off" />
                    </div>
                </div>

                <div class="col-12 col-sm-7 col-md-6 col-lg-3">
                    <label for="reportType" class="form-label fw-semibold small text-muted mb-1">
                        Zakres raportu
                    </label>
                    <select id="reportType" name="reportType" class="form-select">
                        <option value="active_overdue" selected="@(ViewBag.CurrentReportType == "active_overdue")">Aktywne zaległości</option>
                        <option value="historical_fines" selected="@(ViewBag.CurrentReportType == "historical_fines")">Zwrócone z karą (historia)</option>
                        <option value="all_fines" selected="@(ViewBag.CurrentReportType == "all_fines")">Wszystkie zaległości i kary</option>
                    </select>
                </div>

                <div class="col-12 col-sm-5 col-md-4 col-lg-2">
                    <label for="minDaysOverdue" class="form-label fw-semibold small text-muted mb-1">
                        Min. dni po terminie
                    </label>
                    <input type="number" id="minDaysOverdue" name="minDaysOverdue" value="@ViewBag.MinDaysOverdue"
                           min="1" class="form-control" placeholder="np. 7" />
                </div>

                <div class="col-12 col-md-8 col-lg-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-funnel me-1"></i>Filtruj
                    </button>
                    <a asp-action="OverdueReport" class="btn btn-outline-secondary" title="Resetuj filtry">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>

                <div class="col-12 d-none" id="loadingIndicatorWrapper">
                    <span id="loadingIndicator" class="text-primary small fw-semibold">
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        Aktualizowanie raportu...
                    </span>
                </div>
            </form>
        </div>
    </div>

    <!-- Kontener tabeli raportu (aktualizowany przez AJAX) -->
    <div id="overdueReportContainer" style="transition: opacity 0.18s ease;">
        <partial name="_OverdueReportPartial" model="Model" />
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('overdueFilterForm');
            const container = document.getElementById('overdueReportContainer');
            const loaderWrapper = document.getElementById('loadingIndicatorWrapper');
            let timeout = null;

            function fetchReport() {
                if (loaderWrapper) loaderWrapper.classList.remove('d-none');
                container.style.opacity = '0.55';

                const params = new URLSearchParams(new FormData(form)).toString();
                const url = `${form.action}?${params}`;

                fetch(url, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(response => {
                    if (!response.ok) throw new Error('Błąd pobierania raportu');
                    return response.text();
                })
                .then(html => {
                    container.innerHTML = html;
                    window.history.replaceState({}, '', url);
                })
                .catch(err => console.error('Błąd filtrowania raportu:', err))
                .finally(() => {
                    if (loaderWrapper) loaderWrapper.classList.add('d-none');
                    container.style.opacity = '1';
                });
            }

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                fetchReport();
            });

            form.querySelectorAll('input').forEach(input => {
                input.addEventListener('input', function () {
                    clearTimeout(timeout);
                    timeout = setTimeout(fetchReport, 300);
                });
            });

            form.querySelectorAll('select').forEach(select => {
                select.addEventListener('change', fetchReport);
            });
        });
    </script>
}