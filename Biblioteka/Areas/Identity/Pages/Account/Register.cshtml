@page
@model RegisterModel
@{
    ViewData["Title"] = "Rejestracja";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6">
            <div class="card border-0">
                <div class="card-body p-4 p-sm-5">
                    <!-- Nagłówek karty -->
                    <div class="text-center mb-4">
                        <div class="bg-primary-soft rounded-3 d-inline-flex align-items-center justify-content-center mb-3"
                             style="width: 56px; height: 56px; font-size: 1.5rem;">
                            <i class="bi bi-person-plus"></i>
                        </div>
                        <h2 class="h4 fw-bold mb-1">Utwórz konto czytelnika</h2>
                        <p class="text-muted small mb-0">Zarejestruj się, aby rezerwować i wypożyczać książki w bibliotece</p>
                    </div>

                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 py-2 small mb-3" role="alert"></div>

                        <!-- Imię i Nazwisko -->
                        <div class="row g-3 mb-3">
                            <div class="col-12 col-sm-6">
                                <label asp-for="Input.FirstName" class="form-label fw-semibold small text-muted mb-1">Imię</label>
                                <input asp-for="Input.FirstName"
                                       class="form-control"
                                       autocomplete="given-name"
                                       aria-required="true"
                                       placeholder="Jan" />
                                <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-sm-6">
                                <label asp-for="Input.LastName" class="form-label fw-semibold small text-muted mb-1">Nazwisko</label>
                                <input asp-for="Input.LastName"
                                       class="form-control"
                                       autocomplete="family-name"
                                       aria-required="true"
                                       placeholder="Kowalski" />
                                <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Adres e-mail -->
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label fw-semibold small text-muted mb-1">Adres e-mail</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white text-muted border-end-0">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <input asp-for="Input.Email"
                                       class="form-control border-start-0 ps-0"
                                       autocomplete="username"
                                       aria-required="true"
                                       placeholder="nazwa@example.com" />
                            </div>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <!-- Hasło -->
                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label fw-semibold small text-muted mb-1">Hasło</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white text-muted border-end-0">
                                    <i class="bi bi-lock"></i>
                                </span>
                                <input asp-for="Input.Password"
                                       id="registerPasswordInput"
                                       class="form-control border-start-0 border-end-0 ps-0"
                                       autocomplete="new-password"
                                       aria-required="true"
                                       placeholder="Utwórz silne hasło..." />
                                <button type="button"
                                        class="btn bg-white border border-start-0 text-muted password-toggle-btn"
                                        data-target="registerPasswordInput"
                                        aria-label="Pokaż lub ukryj hasło"
                                        tabindex="-1">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <!-- Potwierdź hasło -->
                        <div class="mb-4">
                            <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold small text-muted mb-1">Potwierdź hasło</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white text-muted border-end-0">
                                    <i class="bi bi-shield-check"></i>
                                </span>
                                <input asp-for="Input.ConfirmPassword"
                                       id="confirmPasswordInput"
                                       class="form-control border-start-0 border-end-0 ps-0"
                                       autocomplete="new-password"
                                       aria-required="true"
                                       placeholder="Powtórz hasło..." />
                                <button type="button"
                                        class="btn bg-white border border-start-0 text-muted password-toggle-btn"
                                        data-target="confirmPasswordInput"
                                        aria-label="Pokaż lub ukryj potwierdzenie hasła"
                                        tabindex="-1">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <!-- Przycisk rejestracji -->
                        <button id="registerSubmit" type="submit" class="btn btn-accent w-100 py-2 fw-semibold">
                            <i class="bi bi-check2-circle me-1"></i>Zarejestruj się
                        </button>
                    </form>

                    @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                    {
                        <div class="mt-4 pt-3 border-top">
                            <p class="text-muted small text-center mb-2">Lub zarejestruj się za pomocą:</p>
                            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="d-grid gap-2">
                                @foreach (var provider in Model.ExternalLogins!)
                                {
                                    <button type="submit" class="btn btn-outline-primary" name="provider" value="@provider.Name"
                                            title="Zarejestruj się przy użyciu konta @provider.DisplayName">
                                        @provider.DisplayName
                                    </button>
                                }
                            </form>
                        </div>
                    }

                    <!-- Odnośnik do logowania -->
                    <div class="text-center mt-4 pt-3 border-top">
                        <span class="text-muted small">Masz już konto w bibliotece?</span>
                        <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="small fw-semibold text-decoration-none ms-1">
                            Zaloguj się
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".password-toggle-btn").forEach(btn => {
                btn.addEventListener("click", function () {
                    const targetId = this.getAttribute("data-target");
                    const input = document.getElementById(targetId);
                    const icon = this.querySelector("i");

                    if (!input || !icon) return;

                    const isPassword = input.type === "password";
                    input.type = isPassword ? "text" : "password";
                    icon.classList.toggle("bi-eye", !isPassword);
                    icon.classList.toggle("bi-eye-slash", isPassword);
                });
            });
        });
    </script>
}