@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Zmiana hasła";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="mb-4">
    <h3 class="h5 fw-bold mb-1">@ViewData["Title"]</h3>
    <p class="text-muted small mb-0">Zadbaj o bezpieczeństwo swojego konta, ustawiając silne, unikalne hasło</p>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-12 col-lg-8">
        <form id="change-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 py-2 small mb-3" role="alert"></div>

            <!-- Obecne hasło -->
            <div class="mb-3">
                <label asp-for="Input.OldPassword" class="form-label fw-semibold small text-muted mb-1">Aktualne hasło</label>
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted border-end-0">
                        <i class="bi bi-lock"></i>
                    </span>
                    <input asp-for="Input.OldPassword"
                           id="oldPasswordInput"
                           class="form-control border-start-0 border-end-0 ps-0"
                           autocomplete="current-password"
                           aria-required="true"
                           placeholder="Wprowadź obecne hasło..." />
                    <button type="button"
                            class="btn bg-white border border-start-0 text-muted password-toggle-btn"
                            data-target="oldPasswordInput"
                            aria-label="Pokaż lub ukryj obecne hasło"
                            tabindex="-1">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
            </div>

            <!-- Nowe hasło -->
            <div class="mb-3">
                <label asp-for="Input.NewPassword" class="form-label fw-semibold small text-muted mb-1">Nowe hasło</label>
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted border-end-0">
                        <i class="bi bi-key"></i>
                    </span>
                    <input asp-for="Input.NewPassword"
                           id="newPasswordInput"
                           class="form-control border-start-0 border-end-0 ps-0"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="Wprowadź nowe hasło..." />
                    <button type="button"
                            class="btn bg-white border border-start-0 text-muted password-toggle-btn"
                            data-target="newPasswordInput"
                            aria-label="Pokaż lub ukryj nowe hasło"
                            tabindex="-1">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
            </div>

            <!-- Potwierdzenie nowego hasła -->
            <div class="mb-4">
                <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold small text-muted mb-1">Potwierdź nowe hasło</label>
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted border-end-0">
                        <i class="bi bi-shield-check"></i>
                    </span>
                    <input asp-for="Input.ConfirmPassword"
                           id="confirmNewPasswordInput"
                           class="form-control border-start-0 border-end-0 ps-0"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="Powtórz nowe hasło..." />
                    <button type="button"
                            class="btn bg-white border border-start-0 text-muted password-toggle-btn"
                            data-target="confirmNewPasswordInput"
                            aria-label="Pokaż lub ukryj potwierdzenie hasła"
                            tabindex="-1">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-accent px-4 py-2 fw-semibold">
                <i class="bi bi-check2-circle me-1"></i>Zaktualizuj hasło
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".password-toggle-btn").forEach(btn => {
                btn.addEventListener("click", function () {
                    const targetId = this.getAttribute("data-target");
                    const input = document.getElementById(targetId);
                    const icon = this.querySelector("i");

                    if (!input || !icon) return;

                    const isPassword = input.type === "password";
                    input.type = isPassword ? "text" : "password";
                    icon.classList.toggle("bi-eye", !isPassword);
                    icon.classList.toggle("bi-eye-slash", isPassword);
                });
            });
        });
    </script>
}