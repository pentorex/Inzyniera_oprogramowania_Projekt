@page
@model EmailModel
@{
    ViewData["Title"] = "Adres e-mail";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<div class="mb-4">
    <h3 class="h5 fw-bold mb-1">@ViewData["Title"]</h3>
    <p class="text-muted small mb-0">Sprawdź status weryfikacji obecnego adresu lub przypisz nowy adres e-mail do swojego konta</p>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-12 col-lg-8">
        <form id="email-form" method="post">
            <div asp-validation-summary="All" class="alert alert-danger border-0 py-2 small mb-3" role="alert"></div>

            <!-- Aktualny adres e-mail -->
            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold small text-muted mb-1">Aktualny adres e-mail</label>
                @if (Model.IsEmailConfirmed)
                {
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0">
                            <i class="bi bi-envelope"></i>
                        </span>
                        <input asp-for="Email" class="form-control bg-light border-start-0 border-end-0 ps-0" disabled />
                        <span class="input-group-text bg-light text-success border-start-0" title="Adres e-mail zweryfikowany">
                            <i class="bi bi-check-circle-fill"></i>
                        </span>
                    </div>
                    <div class="form-text small text-success">
                        <i class="bi bi-shield-check me-1"></i>Twój obecny adres e-mail jest zweryfikowany.
                    </div>
                }
                else
                {
                    <div class="input-group mb-2">
                        <span class="input-group-text bg-light text-muted border-end-0">
                            <i class="bi bi-envelope"></i>
                        </span>
                        <input asp-for="Email" class="form-control bg-light border-start-0 border-end-0 ps-0" disabled />
                        <span class="input-group-text bg-light text-warning-emphasis border-start-0" title="Adres niezweryfikowany">
                            <i class="bi bi-exclamation-circle"></i>
                        </span>
                    </div>
                    <button id="email-verification"
                            type="submit"
                            asp-page-handler="SendVerificationEmail"
                            class="btn btn-sm btn-outline-primary fw-semibold">
                        <i class="bi bi-send me-1"></i>Wyślij wiadomość weryfikacyjną
                    </button>
                }
            </div>

            <!-- Nowy adres e-mail -->
            <div class="mb-4">
                <label asp-for="Input.NewEmail" class="form-label fw-semibold small text-muted mb-1">Nowy adres e-mail</label>
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted border-end-0">
                        <i class="bi bi-envelope-plus"></i>
                    </span>
                    <input asp-for="Input.NewEmail"
                           class="form-control border-start-0 ps-0"
                           autocomplete="email"
                           aria-required="true"
                           placeholder="nowy.adres@example.com" />
                </div>
                <span asp-validation-for="Input.NewEmail" class="text-danger small"></span>
            </div>

            <button id="change-email-button"
                    type="submit"
                    asp-page-handler="ChangeEmail"
                    class="btn btn-accent px-4 py-2 fw-semibold">
                <i class="bi bi-check2-circle me-1"></i>Zmień adres e-mail
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}