@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container py-4 py-md-5">
    <!-- Nagłówek sekcji -->
    <div class="d-flex align-items-center gap-3 mb-4">
        <div class="bg-primary-soft rounded-3 d-inline-flex align-items-center justify-content-center flex-shrink-0"
             style="width: 48px; height: 48px; font-size: 1.35rem;">
            <i class="bi bi-person-gear"></i>
        </div>
        <div>
            <h1 class="h4 fw-bold mb-1">Ustawienia konta</h1>
            <p class="text-muted small mb-0">Zarządzaj swoimi danymi kontaktowymi, adresem e-mail oraz bezpieczeństwem konta</p>
        </div>
    </div>

    <div class="row g-4">
        <!-- Menu boczne -->
        <div class="col-12 col-md-4 col-lg-3">
            <div class="card border-0">
                <div class="card-body p-2">
                    <partial name="_ManageNav" />
                </div>
            </div>
        </div>

        <!-- Zawartość wybranej zakładki -->
        <div class="col-12 col-md-8 col-lg-9">
            <div class="card border-0">
                <div class="card-body p-4">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}